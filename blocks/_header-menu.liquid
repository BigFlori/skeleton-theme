{% liquid
  assign block_settings = block.settings
  assign menu = block_settings.menu
  assign font_size = block_settings.type_font_primary_size | default: '0.875rem'
  assign font_family_id = block_settings.type_font_primary_link | default: 'body'
  assign text_case = block_settings.type_case_primary_link | default: 'none'
%}

<nav
  class="header-menu"
  aria-label="{{ 'general.header' | t }}"
  style="
    --menu-font-size: {{ font_size }};
    --menu-font-family: var(--font-{{ font_family_id }}--family, inherit);
    --menu-text-case: {{ text_case }};
  "
  {{ block.shopify_attributes }}
>
  <ul class="header-menu__list" role="list">
    {%- for link in menu.links -%}
      <li class="header-menu__item{% if link.links.size > 0 %} header-menu__item--has-children{% endif %}">
        <a
          href="{{ link.url }}"
          class="header-menu__link{% if link.current %} header-menu__link--active{% endif %}"
          {% if link.current %}aria-current="page"{% endif %}
          {% if link.links.size > 0 %}
            aria-expanded="false"
            aria-haspopup="true"
            data-mega-menu-trigger
          {% endif %}
        >
          <span class="header-menu__link-title">{{- link.title -}}</span>
          {%- if link.links.size > 0 -%}
            <svg class="header-menu__caret" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              {%- render 'icon', icon: 'chevron-down' -%}
            </svg>
          {%- endif -%}
        </a>
        {%- if link.links.size > 0 -%}
          {%- render 'mega-menu', link: link -%}
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</nav>

{% stylesheet %}
  .header-menu {
    height: 100%;
    display: flex;
    align-items: stretch;
  }

  .header-menu__list {
    display: flex;
    align-items: stretch;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .header-menu__item {
    display: flex;
    align-items: stretch;
    flex-shrink: 0;
    position: static;
  }

  .header-menu__link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 12px 14px;
    color: var(--ink);
    text-decoration: none;
    font-size: var(--menu-font-size, 0.875rem);
    font-family: var(--menu-font-family, inherit);
    text-transform: var(--menu-text-case, none);
    font-weight: 500;
    transition: color .15s ease, background .15s ease;
    white-space: nowrap;
    border-bottom: 2px solid transparent;
  }

  .header-menu__link:hover {
    color: var(--accent-deep);
    border-bottom-color: var(--accent-deep);
  }

  .header-menu__link--active {
    color: var(--accent-deep);
    font-weight: 600;
    border-bottom-color: var(--accent-deep);
  }

  .header-menu__caret {
    transition: transform .2s ease;
    color: var(--ink-mute);
  }

  /* Caret rotates when mega-menu is open */
  .header-menu__item--has-children.is-open .header-menu__caret,
  .header-menu__item--has-children:hover .header-menu__caret {
    transform: rotate(-180deg);
    color: var(--accent-deep);
  }

  .header-menu__item--has-children:hover .header-menu__link,
  .header-menu__item--has-children.is-open .header-menu__link {
    color: var(--accent-deep);
    border-bottom-color: var(--accent-deep);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Menu",
  "tag": null,
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation menu",
      "default": "main-menu"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "select",
      "id": "type_font_primary_size",
      "label": "Font size",
      "options": [
        { "value": "0.75rem", "label": "12px" },
        { "value": "0.875rem", "label": "14px" },
        { "value": "1rem", "label": "16px" },
        { "value": "1.125rem", "label": "18px" }
      ],
      "default": "0.875rem"
    },
    {
      "type": "select",
      "id": "type_font_primary_link",
      "label": "Font",
      "options": [
        { "value": "body", "label": "Body" },
        { "value": "heading", "label": "Heading" }
      ],
      "default": "body"
    },
    {
      "type": "select",
      "id": "type_case_primary_link",
      "label": "Text case",
      "options": [
        { "value": "none", "label": "Default" },
        { "value": "uppercase", "label": "Uppercase" }
      ],
      "default": "none"
    }
  ]
}
{% endschema %}
