{%- liquid
  assign eyebrow = 'sections.hero.eyebrow' | t
  assign headline = 'sections.hero.headline' | t
  assign headline_italic = 'sections.hero.headline_italic' | t
  assign subcopy = 'sections.hero.subcopy' | t
  assign cta_primary_text = 'sections.hero.cta_primary' | t
  assign cta_primary_url = section.settings.cta_primary_url | default: '#'
  assign cta_ghost_text = 'sections.hero.cta_ghost' | t
  assign cta_ghost_url = section.settings.cta_ghost_url | default: '#'
-%}

<section id="top" class="sw-hero full-width">
  {%- comment -%} Background image — editor override, falls back to bundled asset {%- endcomment -%}
  <div class="sw-hero__bg" aria-hidden="true">
    {%- if section.settings.hero_image != blank -%}
      {{ section.settings.hero_image | image_url: width: 2400 | image_tag: class: 'sw-hero__bg-img', loading: 'eager', fetchpriority: 'high', sizes: '100vw', widths: '768, 1024, 1440, 1920, 2400', alt: '' }}
    {%- else -%}
      <img class="sw-hero__bg-img" src="{{ 'hero_image_webp.webp' | asset_url }}" alt="" width="1344" height="768" loading="eager" fetchpriority="high">
    {%- endif -%}
    <div class="sw-hero__overlay"></div>
  </div>

  <div class="sw-hero__inner">
    <div class="container">

      <div class="sw-hero__content">
        {%- if eyebrow != blank -%}
          <span class="eyebrow sw-hero__eyebrow">{{ eyebrow }}</span>
        {%- endif -%}

        <h1 class="display sw-hero__headline">
          {{- headline }}
          {%- if headline_italic != blank %} <em class="sw-hero__italic">{{ headline_italic }}</em>{% endif -%}
        </h1>

        {%- if subcopy != blank -%}
          <p class="sw-hero__sub">{{ subcopy }}</p>
        {%- endif -%}

        <div class="sw-hero__ctas">
          {%- if cta_primary_text != blank -%}
            <a href="{{ cta_primary_url }}" class="btn btn-primary sw-hero__cta-primary">
              {{ cta_primary_text }}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                {%- render 'icon', icon: 'arrow-right' -%}
              </svg>
            </a>
          {%- endif -%}
          {%- if cta_ghost_text != blank -%}
            <a href="{{ cta_ghost_url }}" class="btn sw-hero__cta-ghost">{{ cta_ghost_text }}</a>
          {%- endif -%}
        </div>
      </div>

    </div>
  </div>
</section>

{% stylesheet %}
/* ── Hero ── */
.sw-hero {
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 70vh;
  overflow: hidden;
  isolation: isolate;
}

/* Background image + overlay */
.sw-hero__bg {
  position: absolute;
  inset: 0;
  z-index: 0;
}

.sw-hero__bg-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.sw-hero__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to bottom,
    oklch(0.22 0.025 155 / 0.55) 0%,
    oklch(0.22 0.025 155 / 0.2) 50%,
    oklch(0.22 0.025 155 / 0.45) 100%
  );
}

.sw-hero__inner {
  position: relative;
  z-index: 1;
  width: 100%;
  padding-top: var(--s-5);
  padding-bottom: var(--s-5);
}

/* Content */
.sw-hero__content {
  max-width: 640px;
  display: flex;
  flex-direction: column;
  gap: var(--s-2);
}

.sw-hero__eyebrow {
  color: var(--sun-soft);
}

.sw-hero__headline {
  font-size: clamp(44px, 6vw, 84px);
  line-height: 1;
  letter-spacing: -0.02em;
  color: var(--accent-ink);
  margin: 0;
  text-shadow: 0 2px 24px oklch(0.15 0.02 155 / 0.35);
}

.sw-hero__italic {
  font-style: italic;
  color: var(--sun);
}

.sw-hero__sub {
  font-size: clamp(16px, 1.4vw, 19px);
  line-height: 1.55;
  color: oklch(0.97 0.01 90 / 0.92);
  max-width: 520px;
  margin: 0;
  text-shadow: 0 1px 12px oklch(0.15 0.02 155 / 0.4);
}

/* CTAs */
.sw-hero__ctas {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  align-items: center;
  margin-top: var(--s-2);
}

.sw-hero__cta-primary {
  font-size: 16px;
  padding: 15px 26px;
  box-shadow: 0 10px 30px oklch(0.22 0.025 155 / 0.35);
}

.sw-hero__cta-ghost {
  font-size: 16px;
  padding: 15px 26px;
  color: var(--accent-ink);
  background: oklch(1 0 0 / 0.08);
  border: 1.5px solid oklch(1 0 0 / 0.7);
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
}

.sw-hero__cta-ghost:hover {
  background: var(--accent-ink);
  color: var(--accent-deep);
  border-color: var(--accent-ink);
  transform: translateY(-1px);
}

/* Responsive */
@media (max-width: 900px) {
  .sw-hero__headline {
    font-size: clamp(36px, 8vw, 56px);
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image",
      "info": "Leave empty to use the bundled hero photo."
    },
    {
      "type": "header",
      "content": "Copy",
      "info": "Headline, subcopy and button labels are translated in the locale files under sections.hero.*"
    },
    {
      "type": "header",
      "content": "Primary CTA"
    },
    {
      "type": "url",
      "id": "cta_primary_url",
      "label": "Button URL"
    },
    {
      "type": "header",
      "content": "Secondary CTA"
    },
    {
      "type": "url",
      "id": "cta_ghost_url",
      "label": "Button URL"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
