<footer class="sw-footer full-width">
  <div class="container">

    {%- comment -%} Main columns {%- endcomment -%}
    <div class="sw-footer__cols">

      {%- comment -%} Brand column {%- endcomment -%}
      <div class="sw-footer__brand">
        <a href="{{ routes.root_url }}" class="sw-footer__logo" aria-label="{{ shop.name }}">
          <div class="sw-footer__logo-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              {%- render 'icon', icon: 'sun' -%}
            </svg>
          </div>
          <span class="display sw-footer__logo-name">{{ shop.name }}</span>
        </a>
        <p class="sw-footer__tagline">{{ 'sections.footer.tagline' | t }}</p>
        <div class="sw-footer__flags" aria-label="{{ 'sections.footer.flags_label' | t }}">
          <span class="sw-footer__flag" title="Österreich" role="img" aria-label="Österreich">
            <svg width="20" height="14" viewBox="0 0 20 14" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <rect width="20" height="14" fill="#ED2939"/>
              <rect y="4.667" width="20" height="4.667" fill="#FFFFFF"/>
            </svg>
          </span>
          <span class="sw-footer__flag" title="Deutschland" role="img" aria-label="Deutschland">
            <svg width="20" height="14" viewBox="0 0 20 14" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <rect width="20" height="4.667" fill="#000000"/>
              <rect y="4.667" width="20" height="4.667" fill="#DD0000"/>
              <rect y="9.333" width="20" height="4.667" fill="#FFCE00"/>
            </svg>
          </span>
        </div>
      </div>

      {%- comment -%} Link groups — from `footer` linklist (top-level item = column, children = links) {%- endcomment -%}
      {%- assign footer_menu = section.settings.menu_main -%}
      {%- if footer_menu == blank -%}
        {%- assign footer_menu = linklists.footer -%}
      {%- endif -%}

      {%- if footer_menu != blank and footer_menu.levels > 0 -%}
        {%- for column in footer_menu.links -%}
          <div class="sw-footer__col">
            {%- if column.links.size > 0 -%}
              <div class="mono sw-footer__col-title">{{ column.title }}</div>
              <ul class="sw-footer__links">
                {%- for link in column.links -%}
                  <li>
                    <a href="{{ link.url }}" class="sw-footer__link">{{ link.title }}</a>
                    {%- if link.links.size > 0 -%}
                      <ul class="sw-footer__links sw-footer__links--nested">
                        {%- for sublink in link.links -%}
                          <li><a href="{{ sublink.url }}" class="sw-footer__link sw-footer__link--sub">{{ sublink.title }}</a></li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            {%- else -%}
              {%- comment -%} Top-level link without children → render as standalone column-titled link {%- endcomment -%}
              <a href="{{ column.url }}" class="mono sw-footer__col-title sw-footer__col-title--link">{{ column.title }}</a>
            {%- endif -%}
          </div>
        {%- endfor -%}
      {%- endif -%}

      {%- comment -%} Contact column — pulled from Shopify Admin › Settings › Store details {%- endcomment -%}
      {%- liquid
        assign shop_address1    = shop.address.address1
        assign shop_city        = shop.address.city
        assign shop_zip         = shop.address.zip
        assign shop_country_code = shop.address.country_code
        assign has_address = false
        if shop_address1 != blank or shop_city != blank or shop_zip != blank
          assign has_address = true
        endif
        assign address_full = ''
        if shop_zip != blank
          assign address_full = shop_country_code | append: '-' | append: shop_zip
        endif
        if shop_city != blank
          if address_full != blank
            assign address_full = address_full | append: ' ' | append: shop_city
          else
            assign address_full = shop_city
          endif
        endif
        if shop_address1 != blank
          if address_full != blank
            assign address_full = address_full | append: ', ' | append: shop_address1
          else
            assign address_full = shop_address1
          endif
        endif
      -%}

      {%- if shop.phone != blank or shop.email != blank or has_address -%}
        <div class="sw-footer__col sw-footer__col--contact">
          <div class="mono sw-footer__col-title">{{ 'sections.footer.contact_title' | t }}</div>
          <ul class="sw-footer__contact" aria-label="{{ 'sections.footer.contact_label' | t }}">
            {%- if shop.phone != blank -%}
              <li class="sw-footer__contact-item">
                <span class="sw-footer__contact-icon" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    {%- render 'icon', icon: 'phone' -%}
                  </svg>
                </span>
                <a class="sw-footer__contact-link js-format-hun-phone" href="tel:{{ shop.phone | remove: ' ' | remove: '-' }}" data-raw="{{ shop.phone | escape }}">
                  {{ shop.phone }}
                </a>
              </li>
            {%- endif -%}
            {%- if shop.email != blank -%}
              <li class="sw-footer__contact-item">
                <span class="sw-footer__contact-icon" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    {%- render 'icon', icon: 'mail' -%}
                  </svg>
                </span>
                <a class="sw-footer__contact-link" href="mailto:{{ shop.email }}">
                  {{ shop.email }}
                </a>
              </li>
            {%- endif -%}
            {%- if has_address -%}
              <li class="sw-footer__contact-item">
                <span class="sw-footer__contact-icon" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    {%- render 'icon', icon: 'map-pin' -%}
                  </svg>
                </span>
                <span class="sw-footer__contact-text">{{ address_full }}</span>
              </li>
            {%- endif -%}
          </ul>
        </div>
      {%- endif -%}

    </div>

    {%- comment -%} Bottom bar {%- endcomment -%}
    <div class="sw-footer__bottom">
      <div class="mono sw-footer__copy">
        &copy; {{ 'now' | date: '%Y' }} {{ section.settings.legal_name }}
      </div>
      <div class="sw-footer__legal-links">
        {%- assign legal_menu = section.settings.menu_legal -%}
        {%- if legal_menu == blank -%}
          {%- assign legal_menu = linklists.policies -%}
        {%- endif -%}
        {%- if legal_menu != blank -%}
          {%- for link in legal_menu.links -%}
            <a href="{{ link.url }}" class="sw-footer__legal-link">{{ link.title }}</a>
          {%- endfor -%}
        {%- endif -%}
      </div>
      {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <div class="sw-footer__payment" aria-label="{{ 'sections.footer.payment_methods' | t }}">
          {%- for type in shop.enabled_payment_types -%}
            {{ type | payment_type_svg_tag }}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

  </div>
</footer>

<script src="{{ 'contact-phone.js' | asset_url }}" defer></script>

{% stylesheet %}
.sw-footer {
  padding: var(--s-6) 0 var(--s-4);
  background: var(--bg);
  border-top: 1px solid var(--line-soft);
}

/* Main grid: brand + up to 2 menu columns + contact */
.sw-footer__cols {
  display: grid;
  grid-template-columns: 1.5fr 1fr 1fr 1.2fr;
  gap: 40px;
  margin-bottom: var(--s-5);
}

/* Brand column */
.sw-footer__logo {
  display: flex;
  align-items: center;
  gap: 10px;
  text-decoration: none;
  color: inherit;
  margin-bottom: 16px;
}

.sw-footer__logo-icon {
  width: 36px;
  height: 36px;
  background: var(--accent-deep);
  color: var(--sun);
  border-radius: 12px 12px 12px 2px;
  display: grid;
  place-items: center;
  flex-shrink: 0;
}

.sw-footer__logo-name {
  font-size: 26px;
  color: var(--ink);
}

.sw-footer__tagline {
  font-size: 13px;
  color: var(--ink-soft);
  max-width: 300px;
  line-height: 1.6;
  margin: 0 0 20px;
}

.sw-footer__flags {
  display: flex;
  gap: 6px;
}

.sw-footer__flag {
  display: inline-flex;
  align-items: center;
  line-height: 1;
}
.sw-footer__flag svg {
  display: block;
  border-radius: 2px;
  box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.08);
}

/* Contact info */
.sw-footer__contact {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.sw-footer__contact-item {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  font-size: 13px;
  color: var(--ink-soft);
  line-height: 1.5;
}

.sw-footer__contact-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 16px;
  height: 16px;
  margin-top: 2px;
  color: var(--ink-mute);
}

.sw-footer__contact-link {
  color: inherit;
  text-decoration: none;
  transition: color 0.15s;
}

.sw-footer__contact-link:hover {
  color: var(--accent-deep);
}

.sw-footer__contact-text {
  white-space: pre-line;
}

/* Link columns */
.sw-footer__col-title {
  font-size: 11px;
  color: var(--ink-mute);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin-bottom: 18px;
}

.sw-footer__links {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.sw-footer__link {
  font-size: 13px;
  color: var(--ink-soft);
  text-decoration: none;
  transition: color 0.15s;
  cursor: pointer;
}

a.sw-footer__link:hover {
  color: var(--accent-deep);
}

.sw-footer__links--nested {
  margin-top: 8px;
  padding-left: 12px;
  border-left: 1px solid var(--line-soft);
  gap: 6px;
}

.sw-footer__link--sub {
  font-size: 12px;
  color: var(--ink-mute);
}

.sw-footer__col-title--link {
  display: inline-block;
  text-decoration: none;
  cursor: pointer;
  transition: color 0.15s;
}

.sw-footer__col-title--link:hover {
  color: var(--accent-deep);
}

/* Bottom bar */
.sw-footer__bottom {
  position: relative;
  padding-top: 24px;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 12px;
}

.sw-footer__bottom::before {
  content: "";
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 100vw;
  height: 1px;
  background: var(--line-soft);
}

.sw-footer__copy {
  font-size: 12px;
  color: var(--ink-mute);
  letter-spacing: 0.03em;
}

.sw-footer__legal-links {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24px;
  flex-wrap: wrap;
}

.sw-footer__legal-link {
  font-size: 12px;
  color: var(--ink-mute);
  text-decoration: none;
  transition: color 0.15s;
}

.sw-footer__legal-link:hover {
  color: var(--ink-soft);
}

.sw-footer__payment {
  display: flex;
  gap: 8px;
  align-items: center;
}

.sw-footer__payment svg {
  height: 20px;
  width: auto;
  opacity: 0.5;
}

@media (max-width: 1024px) {
  .sw-footer__cols {
    grid-template-columns: 1fr 1fr 1fr;
  }

  .sw-footer__brand {
    grid-column: 1 / -1;
  }
}

@media (max-width: 600px) {
  .sw-footer__cols {
    grid-template-columns: 1fr 1fr;
  }

}
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.footer",
  "settings": [
    {
      "type": "link_list",
      "id": "menu_main",
      "label": "Footer menu",
      "default": "footer",
      "info": "Top-level items become column titles; their children become the links. Supports nested sub-links."
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Brand tagline",
      "default": "Unabh\u00E4ngiger Solar-Fachhandel aus Wiener Neustadt. Versand in ganz \u00D6sterreich, Bayern & S\u00FCddeutschland."
    },
    {
      "type": "text",
      "id": "legal_name",
      "label": "Legal name (for copyright)",
      "default": "Sonnwerk Solar GmbH"
    },
    {
      "type": "link_list",
      "id": "menu_legal",
      "label": "Legal links menu (Impressum, AGB, etc.)",
      "info": "Leave empty to use the `policies` menu by default."
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:labels.show_payment_icons",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Footer"
    }
  ]
}
{% endschema %}
