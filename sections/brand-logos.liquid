<section class="sw-brands full-width" aria-label="{{ 'sections.brands.aria_label' | t }}">
  <div class="container">
    <div class="sw-brands__header">
      <span class="eyebrow">{{ 'sections.brands.heading' | t }}</span>
    </div>
  </div>

  <div class="sw-brands__outer">
    <div class="sw-brands__track">

      {%- comment -%}
        4 passes ensure the track is wide enough for ultra-wide screens.
        Pass 1 carries accessible alt text and block editor attributes;
        passes 2–4 are purely visual duplicates (aria-hidden).
      {%- endcomment -%}
      {%- for pass in (1..4) -%}

        <div class="sw-brands__item"{% if pass > 1 %} aria-hidden="true"{% endif %}>
          <img src="{{ 'JA_SOLAR/JA_SOLAR_idEWD3SSud_1.svg' | asset_url }}"
               alt="{% if pass == 1 %}JA Solar{% endif %}" width="453" height="80" loading="lazy">
        </div>
        <div class="sw-brands__item"{% if pass > 1 %} aria-hidden="true"{% endif %}>
          <img src="{{ 'Huawei/Huawei_idfUUSTrcr_0.svg' | asset_url }}"
               alt="{% if pass == 1 %}Huawei{% endif %}" width="818" height="179" loading="lazy">
        </div>
        <div class="sw-brands__item"{% if pass > 1 %} aria-hidden="true"{% endif %}>
          <img src="{{ 'Sungrow/Sungrow_idIZ3cdahY_1.svg' | asset_url }}"
               alt="{% if pass == 1 %}Sungrow{% endif %}" width="1552" height="340" loading="lazy">
        </div>
        <div class="sw-brands__item"{% if pass > 1 %} aria-hidden="true"{% endif %}>
          <img src="{{ 'solplanet_logo.png' | asset_url }}"
               alt="{% if pass == 1 %}Solplanet{% endif %}" width="157" height="40" loading="lazy">
        </div>
        <div class="sw-brands__item"{% if pass > 1 %} aria-hidden="true"{% endif %}>
          <img src="{{ 'trinasolar_logo.png' | asset_url }}"
               alt="{% if pass == 1 %}Trina Solar{% endif %}" width="499" height="118" loading="lazy">
        </div>

        {%- for block in section.blocks -%}
          {%- if block.type == 'logo' and block.settings.logo != blank -%}
            <div class="sw-brands__item"{% if pass > 1 %} aria-hidden="true"{% else %} {{ block.shopify_attributes }}{% endif %}>
              <img src="{{ block.settings.logo | image_url: height: 72 }}"
                   alt="{% if pass == 1 %}{{ block.settings.name | default: block.settings.logo.alt }}{% endif %}"
                   width="{{ block.settings.logo.width }}" height="{{ block.settings.logo.height }}"
                   loading="lazy">
            </div>
          {%- endif -%}
        {%- endfor -%}

      {%- endfor -%}

    </div>
  </div>
</section>

{% stylesheet %}
.sw-brands {
  padding: var(--s-5) 0 var(--s-4);
  background: var(--bg-warm);
  border-top: 1px solid var(--line-soft);
  border-bottom: 1px solid var(--line-soft);
}

.sw-brands__header {
  display: flex;
  justify-content: center;
  margin-bottom: var(--s-4);
}

.sw-brands__outer {
  position: relative;
  overflow: hidden;
}

.sw-brands__outer::before,
.sw-brands__outer::after {
  content: '';
  position: absolute;
  top: 0;
  bottom: 0;
  width: 100px;
  z-index: 1;
  pointer-events: none;
}

.sw-brands__outer::before {
  left: 0;
  background: linear-gradient(to right, var(--bg-warm) 0%, transparent 100%);
}

.sw-brands__outer::after {
  right: 0;
  background: linear-gradient(to left, var(--bg-warm) 0%, transparent 100%);
}

.sw-brands__track {
  display: flex;
  align-items: center;
  width: max-content;
  gap: 64px;
  padding: var(--s-3) 0;
  animation: sw-brands-scroll 36s linear infinite;
}

.sw-brands__track:hover {
  animation-play-state: paused;
}

@media (min-width: 901px) {
  .sw-brands__track {
    gap: 120px;
  }
}

.sw-brands__item {
  flex-shrink: 0;
  width: 160px;
  height: 48px;
}

.sw-brands__item img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  object-position: center;
  display: block;
  opacity: 0.6;
  filter: grayscale(1);
  transition: opacity 0.25s ease, filter 0.25s ease;
}

.sw-brands__item:hover img {
  opacity: 1;
  filter: grayscale(0);
}

@keyframes sw-brands-scroll {
  from { transform: translateX(0); }
  to   { transform: translateX(-25%); }
}

@media (prefers-reduced-motion: reduce) {
  .sw-brands__track {
    animation: none;
    flex-wrap: wrap;
    width: auto;
    justify-content: center;
    gap: 48px;
    padding: var(--s-3) var(--s-4);
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Brand Logos",
  "settings": [],
  "blocks": [
    {
      "type": "logo",
      "name": "Brand logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo image"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Brand name",
          "info": "Used as alt text. Leave blank to use the image alt text."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand Logos"
    }
  ]
}
{% endschema %}
