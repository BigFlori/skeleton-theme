<section id="pakete" class="sw-packages">
  <div class="container">

    <div class="sw-packages__header">
      <div>
        <span class="eyebrow">{{ 'sections.featured_packages.eyebrow' | t }}</span>
        <h2 class="display sw-packages__headline">
          {{ 'sections.featured_packages.headline_1' | t }}<br>
          <em class="sw-packages__italic">{{ 'sections.featured_packages.headline_italic' | t }}</em> {{ 'sections.featured_packages.headline_2' | t }}
        </h2>
      </div>
      <p class="sw-packages__sub">
        {{ 'sections.featured_packages.description' | t }}
      </p>
    </div>

    <div class="sw-packages__grid">
      {%- assign products_shown = 0 -%}
      {%- assign pkg_collection = section.settings.collection | default: collections['packages'] -%}
      {%- if pkg_collection != blank and pkg_collection.products.size > 0 -%}
        {%- for product in pkg_collection.products limit: 4 -%}
          {%- render 'collection-pkg-card', product: product -%}
          {%- assign products_shown = products_shown | plus: 1 -%}
        {%- endfor -%}
      {%- endif -%}

      {%- comment -%} Fallback placeholder cards in the theme editor {%- endcomment -%}
      {%- if products_shown == 0 -%}
        {%- for i in (1..4) -%}
          <article class="pkg-card">
            <div class="pkg-card__visual" aria-hidden="true">
              {{ 'product-' | append: i | placeholder_svg_tag: 'pkg-card__img placeholder-svg' }}
            </div>
            <h3 class="display pkg-card__name">{{ 'general.onboarding.product_title' | t }}</h3>
            <div class="pkg-card__footer">
              <div class="display pkg-card__price">€ 0.000</div>
              <button class="pkg-card__atc" disabled aria-hidden="true">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
              </button>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- comment -%} Configurator promo strip {%- endcomment -%}
    <div class="sw-packages__promo">
        <div class="sw-packages__promo-left">
          <div class="sw-packages__promo-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/>
            </svg>
          </div>
          <div>
            <p class="sw-packages__promo-title">{{ 'sections.featured_packages.configurator_text' | t }}</p>
            <p class="mono sw-packages__promo-sub">{{ 'sections.featured_packages.configurator_sub' | t }}</p>
          </div>
        </div>
        <a href="{{ section.settings.configurator_url }}" class="btn sw-packages__promo-btn">
          {{ 'sections.featured_packages.to_configurator' | t }}
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
    </div>

  </div>
</section>

<script src="{{ 'collection.js' | asset_url }}" defer></script>

{% stylesheet %}
.sw-packages {
  padding: var(--s-6) 0;
}

.sw-packages__header {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--s-4);
  align-items: end;
  margin-bottom: var(--s-5);
}

.sw-packages__headline {
  font-size: clamp(40px, 5vw, 72px);
  margin-top: 18px;
  line-height: 1;
}

.sw-packages__italic {
  font-style: italic;
  color: var(--accent-deep);
}

.sw-packages__sub {
  color: var(--ink-soft);
  font-size: 16px;
  max-width: 480px;
  justify-self: end;
  line-height: 1.6;
  margin: 0;
}

/* 4-column card grid */
.sw-packages__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
}

/* Promo strip */
.sw-packages__promo {
  margin-top: var(--s-4);
  background: var(--accent-soft);
  border-radius: var(--radius-lg);
  padding: 22px 28px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24px;
  flex-wrap: wrap;
}

.sw-packages__promo-left {
  display: flex;
  align-items: center;
  gap: 14px;
}

.sw-packages__promo-icon {
  width: 40px;
  height: 40px;
  background: var(--accent-deep);
  color: var(--sun);
  border-radius: 10px;
  display: grid;
  place-items: center;
  flex-shrink: 0;
}

.sw-packages__promo-title {
  font-size: 15px;
  font-weight: 500;
  margin: 0;
}

.sw-packages__promo-sub {
  font-size: 11px;
  color: var(--ink-soft);
  margin: 2px 0 0;
}

.sw-packages__promo-btn {
  background: var(--sun);
  color: var(--ink);
  font-weight: 600;
  white-space: nowrap;
  flex-shrink: 0;
}

.sw-packages__promo-btn:hover {
  background: var(--ink);
  color: var(--accent-ink);
}

/* Responsive */
@media (max-width: 1100px) {
  .sw-packages__grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 700px) {
  .sw-packages__header {
    grid-template-columns: 1fr;
  }
  .sw-packages__sub {
    justify-self: start;
  }
  .sw-packages__grid {
    grid-template-columns: 1fr;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Featured Packages",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Packages collection",
      "info": "Leave blank to use the collection with handle 'packages'."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Section description",
      "default": "Curated by our engineers \u2014 modules, inverters and mounting systems matched together. No guesswork, no wrong purchase. All prices incl. 0\u00a0% VAT (zero tax rate Austria)."
    },
    {
      "type": "header",
      "content": "Configurator strip"
    },
    {
      "type": "text",
      "id": "configurator_text",
      "label": "Promo title",
      "default": "Nothing fits perfectly? Start the configurator."
    },
    {
      "type": "text",
      "id": "configurator_sub",
      "label": "Promo subtitle",
      "default": "4 steps to your own package \u2014 with installation or DIY"
    },
    {
      "type": "url",
      "id": "configurator_url",
      "label": "Configurator link"
    }
  ],
  "presets": [
    {
      "name": "Featured Packages"
    }
  ]
}
{% endschema %}
