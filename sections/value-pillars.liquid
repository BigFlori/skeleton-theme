        {
          "type": "text",
          "id": "discount",
          "label": "Discount (e.g. 3%)",
          "default": "3%"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Value Pillars",
      "settings": {
        "cta_login": "Sign in",
        "cta_register": "Create account",
        "cta_note": "No minimum order.",
        "table_title": "PARTNER DISCOUNTS"
      },
      "blocks": [
        {
          "type": "pillar",
          "settings": {
            "icon": "bolt",
            "title": "Partner discount",
            "description": "Registered partners receive 3–9% discount on all orders. No minimum order."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "icon": "star",
            "title": "Market-leading prices",
            "description": "Direct from importer — no middleman markups. Competitive prices guaranteed."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "icon": "phone",
            "title": "Technical support",
            "description": "Phone & email support Mon–Fri by our engineers. Free for all customers."
          }
        },
        { "type": "tier", "settings": { "from_label": "from € 500", "discount": "3%" } },
        { "type": "tier", "settings": { "from_label": "from € 1.000", "discount": "5%" } },
        { "type": "tier", "settings": { "from_label": "from € 2.500", "discount": "7%" } },
        { "type": "tier", "settings": { "from_label": "from € 5.000", "discount": "9%" } }
      ]
    }
  ]
}
