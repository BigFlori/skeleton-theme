<section class="sw-pillars full-width">
  <div class="container">

    <div class="sw-pillars__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'pillar' -%}
          <div class="sw-pillars__pillar" {{ block.shopify_attributes }}>
            <div class="sw-pillars__pillar-icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                {%- render 'icon', icon: block.settings.icon -%}
              </svg>
            </div>
            <h3 class="sw-pillars__pillar-title">{{ block.settings.title }}</h3>
            <p class="sw-pillars__pillar-desc">{{ block.settings.description }}</p>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="sw-pillars__cta-area">
      <div class="sw-pillars__cta-row">
        <a href="{{ section.settings.login_url | default: routes.account_login_url }}" class="btn btn-primary">
          {{ section.settings.cta_login }}
        </a>
        <a href="{{ section.settings.register_url | default: routes.account_register_url }}" class="btn btn-ghost">
          {{ section.settings.cta_register }}
        </a>
      </div>
      {%- if section.settings.cta_note != blank -%}
        <p class="mono sw-pillars__cta-note">{{ section.settings.cta_note }}</p>
      {%- endif -%}
    </div>

    {%- assign has_tiers = false -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'tier' -%}{%- assign has_tiers = true -%}{%- break -%}{%- endif -%}
    {%- endfor -%}

    {%- if has_tiers -%}
      <div class="sw-pillars__tiers-wrap">
        {%- if section.settings.table_title != blank -%}
          <p class="mono sw-pillars__tiers-label">{{ section.settings.table_title }}</p>
        {%- endif -%}
        <div class="sw-pillars__tiers">
          {%- for block in section.blocks -%}
            {%- if block.type == 'tier' -%}
              <div class="sw-pillars__tier" {{ block.shopify_attributes }}>
                <span class="mono sw-pillars__tier-from">{{ block.settings.from_label }}</span>
                <span class="sw-pillars__tier-pct">{{ block.settings.discount }}</span>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

  </div>
</section>

{% stylesheet %}
.sw-pillars {
  padding: var(--s-5) 0;
  background: var(--bg-warm);
  border-bottom: 1px solid var(--line);
}

.sw-pillars__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  margin-bottom: var(--s-4);
}

.sw-pillars__pillar {
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding: 24px;
  background: var(--bg-card);
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
}

.sw-pillars__pillar-icon {
  width: 48px;
  height: 48px;
  background: var(--accent-soft);
  color: var(--accent-deep);
  border-radius: 12px;
  display: grid;
  place-items: center;
  flex-shrink: 0;
}

.sw-pillars__pillar-title {
  font-size: 17px;
  font-weight: 600;
  color: var(--ink);
  margin: 0;
  line-height: 1.2;
}

.sw-pillars__pillar-desc {
  font-size: 14px;
  color: var(--ink-soft);
  line-height: 1.6;
  margin: 0;
}

.sw-pillars__cta-area {
  display: flex;
  align-items: center;
  gap: 16px;
  flex-wrap: wrap;
  margin-bottom: var(--s-4);
}

.sw-pillars__cta-row {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

.sw-pillars__cta-note {
  font-size: 11px;
  color: var(--ink-mute);
  letter-spacing: 0.03em;
  margin: 0;
}

.sw-pillars__tiers-wrap {
  border-top: 1px dashed var(--line);
  padding-top: var(--s-3);
}

.sw-pillars__tiers-label {
  font-size: 10px;
  color: var(--ink-mute);
  letter-spacing: 0.07em;
  text-transform: uppercase;
  margin: 0 0 12px;
}

.sw-pillars__tiers {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

.sw-pillars__tier {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 14px 22px;
  background: var(--bg-card);
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  gap: 6px;
  min-width: 100px;
}

.sw-pillars__tier-from {
  font-size: 10px;
  color: var(--ink-mute);
  letter-spacing: 0.04em;
  text-align: center;
}

.sw-pillars__tier-pct {
  font-family: var(--font-display);
  font-size: 30px;
  color: var(--accent-deep);
  line-height: 1;
  font-weight: 700;
}

@media (max-width: 900px) {
  .sw-pillars__grid {
    grid-template-columns: 1fr;
    gap: 14px;
  }
}

@media (max-width: 540px) {
  .sw-pillars__tiers {
    gap: 8px;
  }
  .sw-pillars__tier {
    flex: 1;
    min-width: 70px;
    padding: 12px 10px;
  }
  .sw-pillars__tier-pct {
    font-size: 24px;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Value Pillars",
  "settings": [
    {
      "type": "text",
      "id": "cta_login",
      "label": "Login button label",
      "default": "Sign in"
    },
    {
      "type": "url",
      "id": "login_url",
      "label": "Login URL (leave empty for default)"
    },
    {
      "type": "text",
      "id": "cta_register",
      "label": "Register button label",
      "default": "Create account"
    },
    {
      "type": "url",
      "id": "register_url",
      "label": "Register URL (leave empty for default)"
    },
    {
      "type": "text",
      "id": "cta_note",
      "label": "Note below buttons"
    },
    {
      "type": "text",
      "id": "table_title",
      "label": "Discount table label"
    }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "bolt",    "label": "Bolt / Discount" },
            { "value": "star",    "label": "Star / Price" },
            { "value": "phone",   "label": "Phone" },
            { "value": "truck",   "label": "Truck" },
            { "value": "shield",  "label": "Shield" },
            { "value": "leaf",    "label": "Leaf" },
            { "value": "sun",     "label": "Sun" },
            { "value": "wrench",  "label": "Tools" },
            { "value": "lock",    "label": "Lock" },
            { "value": "check",   "label": "Check" }
          ],
          "default": "bolt"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Partner discount"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Registered partners receive 3–9% discount on all orders."
        }
      ]
    },
    {
      "type": "tier",
      "name": "Discount tier",
      "settings": [
        {
          "type": "text",
          "id": "from_label",
          "label": "From label",
          "default": "from € 500"
