{% liquid
  capture logo
    content_for 'block', type: '_header-logo', id: 'header-logo'
  endcapture

  capture menu
    content_for 'block', type: '_header-menu', id: 'header-menu'
  endcapture

  assign header_class = 'header'
  if section.settings.section_height == 'compact'
    assign header_class = header_class | append: ' header--compact'
  endif
  if section.settings.enable_sticky_header
    assign header_class = header_class | append: ' header--sticky'
  endif
%}

<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    {% if settings.logo %}
      "logo": {{ settings.logo | image_url: width: 500 | prepend: "https:" | json }},
    {% endif %}
    "url": {{ request.origin | append: page.url | json }}
  }
</script>

<header
  id="header-component"
  class="{{ header_class }}"
  data-section-width="{{ section.settings.section_width }}"
>
  <div class="header__row header__row--top">
    <div class="header__columns">
      <div class="header__column header__column--left" data-position="{{ section.settings.logo_position }}">
        {{ logo }}
      </div>

      <div class="header__column header__column--center">
        {% if section.settings.menu_position == 'center' %}
          {{ menu }}
        {% endif %}
      </div>

      <div class="header__column header__column--right">
        {% if section.settings.menu_position == 'left' or section.settings.menu_position == 'right' %}
          <div class="header__menu-inline" data-position="{{ section.settings.menu_position }}">
            {{ menu }}
          </div>
        {% endif %}

        <a
          href="{{ routes.cart_url }}"
          class="header__cart"
          data-cart-drawer-trigger
          aria-label="{{ 'general.cart' | t }} ({{ cart.item_count }})"
        >
          <span class="header__cart-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
              <line x1="3" y1="6" x2="21" y2="6"/>
              <path d="M16 10a4 4 0 01-8 0"/>
            </svg>
          </span>
          <span
            class="header__cart-count"
            data-cart-drawer-count
            {% if cart.item_count == 0 %}hidden{% endif %}
          >
            {{- cart.item_count -}}
          </span>
        </a>
      </div>
    </div>
  </div>
</header>

{% stylesheet %}
  body {
    --header-height: 60px;
    --header-padding-block: 14px;
  }

  .header {
    display: block;
    background: var(--color-background, #ffffff);
    border-bottom: 1px solid transparent;
    width: 100%;
  }

  .header--sticky {
    position: sticky;
    top: 0;
    z-index: 40;
  }

  .header--compact {
    --header-padding-block: 8px;
  }

  .header__row {
    padding-block: var(--header-padding-block);
  }

  .header__columns {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
    max-width: 1440px;
    margin-inline: auto;
    padding-inline: clamp(16px, 4vw, 32px);
  }

  [data-section-width='page-width'] .header__columns {
    max-width: 1280px;
  }

  [data-section-width='full-width'] .header__columns {
    max-width: 100%;
  }

  .header__column {
    display: flex;
    align-items: center;
    min-width: 0;
  }

  .header__column--left {
    justify-content: flex-start;
  }

  .header__column--left[data-position='center'] {
    justify-content: center;
  }

  .header__column--center {
    justify-content: center;
  }

  .header__column--right {
    justify-content: flex-end;
    gap: 16px;
  }

  .header__menu-inline {
    display: none;
  }

  @media screen and (min-width: 750px) {
    .header__menu-inline {
      display: flex;
    }
  }

  .header__cart {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    color: inherit;
    padding: 8px 10px;
    border-radius: 8px;
    position: relative;
  }

  .header__cart:hover {
    background: rgb(0 0 0 / 0.05);
  }

  .header__cart-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .header__cart-count {
    background: var(--color-foreground, #333);
    color: var(--color-background, #fff);
    font-size: 11px;
    font-weight: 600;
    padding: 2px 7px;
    border-radius: 999px;
    line-height: 1;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Header",
  "class": "header-section",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "logo_position",
      "label": "Logo position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "menu_position",
      "label": "Menu position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "Section height",
      "options": [
        { "value": "standard", "label": "Standard" },
        { "value": "compact", "label": "Compact" }
      ],
      "default": "standard"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_header",
      "label": "Enable sticky header",
      "default": true
    }
  ]
}
{% endschema %}
