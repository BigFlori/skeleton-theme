{% liquid
  capture logo
    content_for 'block', type: '_header-logo', id: 'header-logo'
  endcapture

  capture menu
    content_for 'block', type: '_header-menu', id: 'header-menu'
  endcapture

  assign header_class = 'header'
  if section.settings.section_height == 'compact'
    assign header_class = header_class | append: ' header--compact'
  endif
  if section.settings.enable_sticky_header
    assign header_class = header_class | append: ' header--sticky'
  endif

  assign mobile_menu = nil
  for block in section.blocks
    if block.type == '_header-menu'
      assign mobile_menu = block.settings.menu
    endif
  endfor
%}

<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    {% if settings.logo %}
      "logo": {{ settings.logo | image_url: width: 500 | prepend: "https:" | json }},
    {% endif %}
    "url": {{ request.origin | json }}
  }
</script>

<header
  id="header-component"
  class="{{ header_class }}"
  data-section-width="{{ section.settings.section_width }}"
>
  <div class="header__row header__row--top">
    <div class="header__columns">
      <div class="header__column header__column--left" data-position="{{ section.settings.logo_position }}">
        {{ logo }}
      </div>

      <div class="header__column header__column--center">
        {% if section.settings.menu_position == 'center' %}
          {{ menu }}
        {% endif %}
      </div>

      <div class="header__column header__column--right">
        {% if section.settings.menu_position == 'left' or section.settings.menu_position == 'right' %}
          <div class="header__menu-inline" data-position="{{ section.settings.menu_position }}">
            {{ menu }}
          </div>
        {% endif %}

        {%- if localization.available_languages.size > 1 -%}
          <div class="header__lang">
            <details class="header__lang-details">
              <summary class="header__lang-trigger" aria-label="{{ 'general.language' | t }}">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  {%- render 'icon', icon: 'globe' -%}
                </svg>
                <span class="header__lang-code">{{ localization.language.iso_code | upcase }}</span>
                <svg class="header__lang-chevron" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  {%- render 'icon', icon: 'chevron-down' -%}
                </svg>
              </summary>
              <div class="header__lang-dropdown">
                {%- for language in localization.available_languages -%}
                  {%- form 'localization' -%}
                    <input type="hidden" name="language_code" value="{{ language.iso_code }}">
                    <button
                      type="submit"
                      class="header__lang-option{% if language.iso_code == localization.language.iso_code %} header__lang-option--active{% endif %}"
                    >
                      {{ language.endonym_name }}
                    </button>
                  {%- endform -%}
                {%- endfor -%}
              </div>
            </details>
          </div>
        {%- endif -%}

        <button
          type="button"
          class="header__search"
          data-search-trigger
          aria-label="{{ 'search.title' | t }}"
          aria-controls="sw-search-drawer"
          aria-expanded="false"
        >
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            {%- render 'icon', icon: 'search' -%}
          </svg>
        </button>

        <a
          href="{{ routes.cart_url }}"
          class="header__cart"
          data-cart-drawer-trigger
          aria-label="{{ 'general.cart' | t }} ({{ cart.item_count }})"
        >
          <span class="header__cart-icon" aria-hidden="true">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              {%- render 'icon', icon: 'shopping-bag' -%}
            </svg>
          </span>
          <span class="header__cart-label">{{ 'general.cart' | t }}</span>
          <span
            class="header__cart-count"
            data-cart-drawer-count
            {% if cart.item_count == 0 %}hidden{% endif %}
          >
            {{- cart.item_count -}}
          </span>
        </a>

        <button
          type="button"
          class="sw-mobile-nav-trigger"
          data-mobile-nav-trigger
          aria-label="{{ 'general.menu' | t | default: 'Menu' }}"
          aria-expanded="false"
          aria-controls="sw-mobile-nav"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            {%- render 'icon', icon: 'hamburger' -%}
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>

{% stylesheet %}
  body {
    --header-height: 60px;
    --header-padding-block: 14px;
  }

  .header {
    display: block;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    width: 100%;
  }

  .header--sticky {
    position: sticky;
    top: 0;
    z-index: 40;
  }

  .header--compact {
    --header-padding-block: 8px;
  }

  .header__row {
    padding-block: var(--header-padding-block);
  }

  .header__columns {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 24px;
    max-width: 1440px;
    margin-inline: auto;
    padding-inline: clamp(16px, 4vw, 32px);
  }

  @media screen and (min-width: 750px) {
    .header__columns {
      grid-template-columns: 1fr auto 1fr;
    }
  }

  [data-section-width='page-width'] .header__columns {
    max-width: 1280px;
  }

  [data-section-width='full-width'] .header__columns {
    max-width: 100%;
  }

  .header__column {
    display: flex;
    align-items: center;
    min-width: 0;
  }

  .header__column--left {
    justify-content: flex-start;
  }

  .header__column--left[data-position='center'] {
    justify-content: center;
  }

  .header__column--center {
    justify-content: center;
  }

  .header__column--right {
    justify-content: flex-end;
    gap: 16px;
  }

  .header__menu-inline,
  .header__column--center {
    display: none;
  }

  @media screen and (min-width: 750px) {
    .header__menu-inline {
      display: flex;
    }

    .header__column--center {
      display: flex;
    }
  }

  .header__cart {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    text-decoration: none;
    color: var(--ink);
    padding: 8px 10px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: var(--bg-card);
    font-size: 13px;
    font-family: var(--font-sans);
    font-weight: 500;
    transition: border-color .15s ease, background .15s ease, color .15s ease;
  }

  .header__cart-label {
    display: none;
  }

  @media screen and (min-width: 750px) {
    .header__cart {
      padding: 8px 16px;
    }

    .header__cart-label {
      display: inline;
    }
  }

  .header__cart:hover {
    border-color: var(--accent-deep);
    background: var(--accent-soft);
    color: var(--accent-deep);
  }

  .header__cart-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .header__cart-label {
    white-space: nowrap;
  }

  .header__cart-count {
    background: var(--accent-deep);
    color: var(--accent-ink);
    font-size: 11px;
    font-weight: 600;
    padding: 2px 7px;
    border-radius: 999px;
    line-height: 1;
  }

  /* ── Language selector ── */
  .header__lang {
    position: relative;
    display: none;
  }

  @media screen and (min-width: 750px) {
    .header__lang { display: block; }
  }

  .header__lang-details {
    position: relative;
  }

  .header__lang-trigger {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 7px 10px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: var(--bg-card);
    color: var(--ink);
    cursor: pointer;
    font-size: 13px;
    font-family: var(--font-sans);
    font-weight: 500;
    list-style: none;
    white-space: nowrap;
    transition: border-color .15s ease, background .15s ease, color .15s ease;
    user-select: none;
  }

  .header__lang-trigger::-webkit-details-marker { display: none; }

  .header__lang-trigger:hover {
    border-color: var(--accent-deep);
    background: var(--accent-soft);
    color: var(--accent-deep);
  }

  .header__lang-chevron {
    transition: transform .2s ease;
    opacity: 0.6;
  }

  .header__lang-details[open] .header__lang-chevron {
    transform: rotate(180deg);
  }

  .header__lang-dropdown {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    min-width: 140px;
    background: var(--bg-card);
    border: 1px solid var(--line);
    border-radius: 10px;
    box-shadow: 0 8px 24px -4px oklch(0.22 0.025 155 / 0.15);
    padding: 6px;
    z-index: 50;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .header__lang-option {
    width: 100%;
    text-align: left;
    padding: 8px 12px;
    border: none;
    background: transparent;
    color: var(--ink);
    font-size: 13px;
    font-family: var(--font-sans);
    border-radius: 6px;
    cursor: pointer;
    transition: background .12s ease, color .12s ease;
  }

  .header__lang-option:hover {
    background: var(--accent-soft);
    color: var(--accent-deep);
  }

  .header__lang-option--active {
    font-weight: 600;
    color: var(--accent-deep);
  }
{% endstylesheet %}

{%- render 'predictive-search' -%}
{%- render 'mobile-nav-drawer', menu: mobile_menu -%}
<script src="{{ 'mobile-nav.js' | asset_url }}" defer></script>
<script>
  document.addEventListener('click', function(e) {
    document.querySelectorAll('.header__lang-details[open]').forEach(function(el) {
      if (!el.contains(e.target)) el.removeAttribute('open');
    });
  });
</script>

{% schema %}
{
  "name": "Header",
  "class": "header-section",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "logo_position",
      "label": "Logo position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "menu_position",
      "label": "Menu position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "Section height",
      "options": [
        { "value": "standard", "label": "Standard" },
        { "value": "compact", "label": "Compact" }
      ],
      "default": "standard"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_header",
      "label": "Enable sticky header",
      "default": true
    }
  ]
}
{% endschema %}
