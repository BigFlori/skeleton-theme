{% liquid
  capture logo
    content_for 'block', type: '_header-logo', id: 'header-logo'
  endcapture

  capture menu
    content_for 'block', type: '_header-menu', id: 'header-menu'
  endcapture

  assign header_class = 'header'
  if section.settings.section_height == 'compact'
    assign header_class = header_class | append: ' header--compact'
  endif
  if section.settings.enable_sticky_header
    assign header_class = header_class | append: ' header--sticky'
  endif

  assign mobile_menu = nil
  for block in section.blocks
    if block.type == '_header-menu'
      assign mobile_menu = block.settings.menu
    endif
  endfor
%}

{%- comment -%} ── Geo-suggestion banner (shown by JS if visitor's country ≠ current market) ── {%- endcomment -%}
{%- assign rs_geo = request.country -%}
{%- if rs_geo and rs_geo.iso_code != localization.country.iso_code -%}
  {%- assign rs_geo_market = nil -%}
  {%- for mc in localization.available_countries -%}
    {%- if mc.iso_code == rs_geo.iso_code -%}
      {%- assign rs_geo_market = mc -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if rs_geo_market -%}
    {%- assign rs_geo_lang = rs_geo_market.available_languages | first -%}
    <div
      class="region-geo-banner"
      id="region-geo-banner"
      data-country="{{ rs_geo_market.iso_code }}"
      data-language="{{ rs_geo_lang.iso_code }}"
      hidden
    >
      <span class="region-geo-banner__text">
        {%- render 'flag', country: rs_geo_market.iso_code -%}
        {{ 'localization.suggestion_banner' | t: country: rs_geo.name }}
      </span>
      <div class="region-geo-banner__actions">
        <button type="button" class="region-geo-banner__btn region-geo-banner__btn--confirm" data-region-geo-confirm>
          {{ 'localization.confirm' | t }}
        </button>
        <button type="button" class="region-geo-banner__btn region-geo-banner__btn--dismiss" data-region-geo-dismiss>
          {{ 'localization.dismiss' | t }}
        </button>
      </div>
    </div>
  {%- endif -%}
{%- endif -%}

<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    {% if settings.logo %}
      "logo": {{ settings.logo | image_url: width: 500 | prepend: "https:" | json }},
    {% endif %}
    "url": {{ request.origin | json }}
  }
</script>

<header
  id="header-component"
  class="{{ header_class }}"
  data-section-width="{{ section.settings.section_width }}"
>
  <div class="header__row header__row--top">
    <div class="header__columns">
      <div class="header__column header__column--left" data-position="{{ section.settings.logo_position }}">
        {{ logo }}
      </div>

      <div class="header__column header__column--center">
        {% if section.settings.menu_position == 'center' %}
          {{ menu }}
        {% endif %}
      </div>

      <div class="header__column header__column--right">
        {% if section.settings.menu_position == 'left' or section.settings.menu_position == 'right' %}
          <div class="header__menu-inline" data-position="{{ section.settings.menu_position }}">
            {{ menu }}
          </div>
        {% endif %}

        {%- render 'region-selector', variant: 'header' -%}

        <button
          type="button"
          class="header__search"
          data-search-trigger
          aria-label="{{ 'search.title' | t }}"
          aria-controls="sw-search-drawer"
          aria-expanded="false"
        >
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            {%- render 'icon', icon: 'search' -%}
          </svg>
        </button>

        {%- if shop.customer_accounts_enabled -%}
          <a
            href="{{ routes.account_url }}"
            class="header__account"
            aria-label="{{ 'general.account' | t }}"
          >
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              {%- render 'icon', icon: 'user' -%}
            </svg>
          </a>
        {%- endif -%}

        <a
          href="{{ routes.cart_url }}"
          class="header__cart"
          data-cart-drawer-trigger
          aria-label="{{ 'general.cart' | t }} ({{ cart.item_count }})"
        >
          <span class="header__cart-icon" aria-hidden="true">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              {%- render 'icon', icon: 'shopping-bag' -%}
            </svg>
          </span>
          <span class="header__cart-label">{{ 'general.cart' | t }}</span>
          <span
            class="header__cart-count"
            data-cart-drawer-count
            {% if cart.item_count == 0 %}hidden{% endif %}
          >
            {{- cart.item_count -}}
          </span>
        </a>

        <button
          type="button"
          class="sw-mobile-nav-trigger"
          data-mobile-nav-trigger
          aria-label="{{ 'general.menu' | t | default: 'Menu' }}"
          aria-expanded="false"
          aria-controls="sw-mobile-nav"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            {%- render 'icon', icon: 'hamburger' -%}
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>

{% stylesheet %}
  body {
    --header-height: 60px;
    --header-padding-block: 14px;
  }

  .header {
    display: block;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    width: 100%;
  }

  .header--sticky {
    position: sticky;
    top: 0;
    z-index: 40;
  }

  .header--compact {
    --header-padding-block: 8px;
  }

  .header__row {
    padding-block: var(--header-padding-block);
  }

  .header__columns {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 24px;
    max-width: 1440px;
    margin-inline: auto;
    padding-inline: clamp(16px, 4vw, 32px);
  }

  @media screen and (min-width: 750px) {
    .header__columns {
      grid-template-columns: 1fr auto 1fr;
    }
  }

  [data-section-width='page-width'] .header__columns {
    max-width: 1280px;
  }

  [data-section-width='full-width'] .header__columns {
    max-width: 100%;
  }

  .header__column {
    display: flex;
    align-items: center;
    min-width: 0;
  }

  .header__column--left {
    justify-content: flex-start;
  }

  .header__column--left[data-position='center'] {
    justify-content: center;
  }

  .header__column--center {
    justify-content: center;
  }

  .header__column--right {
    justify-content: flex-end;
    gap: 16px;
  }

  .header__menu-inline,
  .header__column--center {
    display: none;
  }

  @media screen and (min-width: 750px) {
    .header__menu-inline {
      display: flex;
    }

    .header__column--center {
      display: flex;
    }
  }

  .header__cart {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    text-decoration: none;
    color: var(--ink);
    padding: 8px 10px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: var(--bg-card);
    font-size: 13px;
    font-family: var(--font-sans);
    font-weight: 500;
    transition: border-color .15s ease, background .15s ease, color .15s ease;
  }

  .header__account {
    display: none;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: var(--bg-card);
    color: var(--ink);
    text-decoration: none;
    transition: border-color .15s ease, background .15s ease, color .15s ease;
  }

  .header__account:hover {
    border-color: var(--accent-deep);
    background: var(--accent-soft);
    color: var(--accent-deep);
  }

  @media screen and (min-width: 750px) {
    .header__account {
      display: inline-flex;
    }
  }

  .header__cart-label {
    display: none;
  }

  @media screen and (min-width: 750px) {
    .header__cart {
      padding: 8px 16px;
    }

    .header__cart-label {
      display: inline;
    }
  }

  .header__cart:hover {
    border-color: var(--accent-deep);
    background: var(--accent-soft);
    color: var(--accent-deep);
  }

  .header__cart-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .header__cart-label {
    white-space: nowrap;
  }

  .header__cart-count {
    background: var(--accent-deep);
    color: var(--accent-ink);
    font-size: 11px;
    font-weight: 600;
    padding: 2px 7px;
    border-radius: 999px;
    line-height: 1;
  }

  /* ── Geo-suggestion banner ── */
  .region-geo-banner {
    width: 100%;
    background: var(--accent-soft);
    border-bottom: 1px solid oklch(0.7 0.1 155 / 0.35);
    padding: 10px clamp(16px, 4vw, 32px);
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 13px;
    font-family: var(--font-sans);
    color: var(--accent-deep);
  }
  .region-geo-banner__text {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: 1;
    min-width: 0;
  }
  .region-geo-banner__actions {
    display: flex;
    gap: 8px;
    flex-shrink: 0;
  }
  .region-geo-banner__btn {
    padding: 5px 12px;
    border-radius: 999px;
    border: 1px solid currentColor;
    background: transparent;
    color: inherit;
    font-size: 12px;
    font-family: var(--font-sans);
    font-weight: 500;
    cursor: pointer;
    white-space: nowrap;
    transition: background .15s ease, color .15s ease;
  }
  .region-geo-banner__btn--confirm {
    background: var(--accent-deep);
    color: var(--accent-ink);
    border-color: var(--accent-deep);
  }
  .region-geo-banner__btn--confirm:hover { opacity: 0.85; }
  .region-geo-banner__btn--dismiss:hover {
    background: var(--accent-deep);
    color: var(--accent-ink);
  }

  /* Hidden localization form */
  #region-localization-form { display: none; }
{% endstylesheet %}

{%- render 'predictive-search' -%}
{%- render 'mobile-nav-drawer', menu: mobile_menu -%}

{%- comment -%} Single localization form — used by all region-selector variants via JS {%- endcomment -%}
{%- form 'localization', id: 'region-localization-form' -%}
  <input type="hidden" name="country_code" id="region-localization-country" value="{{ localization.country.iso_code }}">
  <input type="hidden" name="language_code" id="region-localization-language" value="{{ localization.language.iso_code }}">
{%- endform -%}

<script src="{{ 'mobile-nav.js' | asset_url }}" defer></script>
<script src="{{ 'region-selector.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Header",
  "class": "header-section",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "logo_position",
      "label": "Logo position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "menu_position",
      "label": "Menu position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "Section height",
      "options": [
        { "value": "standard", "label": "Standard" },
        { "value": "compact", "label": "Compact" }
      ],
      "default": "standard"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_header",
      "label": "Enable sticky header",
      "default": true
    }
  ]
}
{% endschema %}
