{% liquid
  capture logo
    content_for 'block', type: '_header-logo', id: 'header-logo'
  endcapture

  capture topbar
    content_for 'block', type: '_header-topbar', id: 'header-topbar'
  endcapture

  capture menu
    content_for 'block', type: '_header-menu', id: 'header-menu'
  endcapture

  assign header_class = 'header'
  if section.settings.enable_sticky_header
    assign header_class = header_class | append: ' header--sticky'
  endif

  assign mobile_menu = nil
  assign mobile_utility_menu = nil
  for block in section.blocks
    if block.type == '_header-menu'
      assign mobile_menu = block.settings.menu
    endif
    if block.type == '_header-topbar'
      assign mobile_utility_menu = block.settings.utility_menu
    endif
  endfor
  # Topbar's utility menu falls back to the "topbar-menu" handle, mirroring the block itself
  unless mobile_utility_menu.links.size > 0
    assign mobile_utility_menu = linklists['topbar-menu']
  endunless
%}

{%- comment -%} ── Geo-suggestion banner ── {%- endcomment -%}
{%- assign rs_geo = request.country -%}
{%- if rs_geo and rs_geo.iso_code != localization.country.iso_code -%}
  {%- assign rs_geo_market = nil -%}
  {%- for mc in localization.available_countries -%}
    {%- if mc.iso_code == rs_geo.iso_code -%}
      {%- assign rs_geo_market = mc -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if rs_geo_market -%}
    {%- assign rs_geo_lang = rs_geo_market.available_languages | first -%}
    <div
      class="region-geo-banner"
      id="region-geo-banner"
      data-country="{{ rs_geo_market.iso_code }}"
      data-language="{{ rs_geo_lang.iso_code }}"
      hidden
    >
      <span class="region-geo-banner__text">
        {%- render 'flag', country: rs_geo_market.iso_code -%}
        {{ 'localization.suggestion_banner' | t: country: rs_geo.name }}
      </span>
      <div class="region-geo-banner__actions">
        <button type="button" class="region-geo-banner__btn region-geo-banner__btn--confirm" data-region-geo-confirm>
          {{ 'localization.confirm' | t }}
        </button>
        <button type="button" class="region-geo-banner__btn region-geo-banner__btn--dismiss" data-region-geo-dismiss>
          {{ 'localization.dismiss' | t }}
        </button>
      </div>
    </div>
  {%- endif -%}
{%- endif -%}

<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    {% if settings.logo %}
      "logo": {{ settings.logo | image_url: width: 500 | prepend: "https:" | json }},
    {% endif %}
    "url": {{ request.origin | json }}
  }
</script>

{%- comment -%} ── ① Top bar — scrolls away, not sticky ── {%- endcomment -%}
{%- if section.settings.enable_top_bar -%}
  <div class="header__row header__row--topbar" data-section-width="{{ section.settings.section_width }}">
    {{ topbar }}
  </div>
{%- endif -%}

<header
  id="header-component"
  class="{{ header_class }}"
  data-section-width="{{ section.settings.section_width }}"
>
  {%- comment -%} ── ② Main bar: logo · search · actions ── {%- endcomment -%}
  <div class="header__row header__row--main">
    <div class="header__main-inner">
      <div class="header__col-mobile-left">
        <button
          type="button"
          class="sw-mobile-nav-trigger"
          data-mobile-nav-trigger
          aria-label="{{ 'general.menu' | t | default: 'Menu' }}"
          aria-expanded="false"
          aria-controls="sw-mobile-nav"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            {%- render 'icon', icon: 'hamburger' -%}
          </svg>
        </button>
        <button
          type="button"
          class="sw-mobile-search-trigger"
          data-search-trigger
          aria-label="{{ 'search.title' | t }}"
          aria-controls="sw-search-drawer"
          aria-expanded="false"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            {%- render 'icon', icon: 'search' -%}
          </svg>
        </button>
      </div>

      <div class="header__col-logo">
        {{ logo }}
      </div>

      {%- if section.settings.enable_inline_search -%}
        <div class="header__col-search">
          <form
            action="{{ routes.search_url }}"
            method="get"
            class="header__inline-search"
            role="search"
            data-inline-search-form
          >
            <input type="hidden" name="type" value="product">
            <svg class="header__inline-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              {%- render 'icon', icon: 'search' -%}
            </svg>
            <label for="header-search-input" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap">{{ 'search.title' | t }}</label>
            <input
              id="header-search-input"
              type="search"
              name="q"
              class="header__inline-search-input"
              autocomplete="off"
              data-predictive-search-input
              data-placeholder-prefix="{{ 'search.typewriter_prefix' | t | escape }}"
              data-placeholders="{{ 'search.typewriter_placeholders' | t | escape }}"
            >
            <button type="submit" class="header__inline-search-btn" aria-label="{{ 'search.title' | t }}">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                {%- render 'icon', icon: 'search' -%}
              </svg>
            </button>
          </form>
          <div
            class="header__inline-search-results"
            data-inline-search-results
            role="region"
            aria-live="polite"
            hidden
          ></div>
        </div>
      {%- endif -%}

      <div class="header__col-actions">
        {%- unless section.settings.enable_inline_search -%}
          <button
            type="button"
            class="header__search"
            data-search-trigger
            aria-label="{{ 'search.title' | t }}"
            aria-controls="sw-search-drawer"
            aria-expanded="false"
          >
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              {%- render 'icon', icon: 'search' -%}
            </svg>
          </button>
        {%- endunless -%}

        {%- comment -%} Region lives in the top bar when enabled; otherwise fall back to the main bar {%- endcomment -%}
        {%- unless section.settings.enable_top_bar -%}
          {%- render 'region-selector', variant: 'header' -%}
        {%- endunless -%}

        {%- if shop.customer_accounts_enabled -%}
          <div class="header__account-wrapper{% if customer %} header__account-wrapper--signed-in{% endif %}">
            {%- if customer -%}
              <span class="header__account-greeting">{{ 'general.greeting' | t: name: customer.first_name }}</span>
            {%- endif -%}
            <shopify-account menu="{{ section.settings.customer_account_menu }}">
              {%- unless customer -%}
                <span slot="signed-out-avatar" class="header__account">
                  <span class="header__account-icon">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      {%- render 'icon', icon: 'user' -%}
                    </svg>
                  </span>
                  <span class="header__account-label">{{ 'general.account' | t }}</span>
                </span>
              {%- endunless -%}
            </shopify-account>
          </div>
        {%- endif -%}

        <a
          href="{{ routes.cart_url }}"
          class="header__cart"
          data-cart-drawer-trigger
          aria-label="{{ 'general.cart' | t }} ({{ cart.item_count }})"
        >
          <span class="header__cart-icon" aria-hidden="true">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              {%- render 'icon', icon: 'shopping-bag' -%}
            </svg>
          </span>
          <span class="header__cart-label">{{ 'general.cart' | t }}</span>
          <span
            class="header__cart-count"
            data-cart-drawer-count
            {% if cart.item_count == 0 %}hidden{% endif %}
          >
            {{- cart.item_count -}}
          </span>
        </a>

      </div>
    </div>
  </div>

  {%- comment -%} ── ③ Nav bar: mega-menu (desktop only) ── {%- endcomment -%}
  <div class="header__row header__row--nav">
    <div class="header__nav-inner">
      {{ menu }}
    </div>
  </div>
</header>

{%- comment -%} Backdrop shown while any mega-menu panel is open; toggled via :has() {%- endcomment -%}
<div class="mega-menu-backdrop" aria-hidden="true"></div>

{% stylesheet %}
  :root {
    /* Main bar (②) and nav bar (③) share one height so they always match.
       Defined on :root (not body) so html-level rules like scroll-padding-top
       resolve the real value instead of their fallback. */
    --header-bar-height: 56px;
    --header-main-height: var(--header-bar-height);
    --header-nav-height: var(--header-bar-height);
    /* Mobile: nav bar (③) is hidden, so only the main bar counts */
    --header-height: var(--header-bar-height);
  }

  @media screen and (min-width: 750px) {
    :root {
      --header-height: calc(var(--header-bar-height) * 2);
    }
  }

  .header {
    display: block;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    width: 100%;
    position: relative;
    z-index: 41;
  }

  .header--sticky {
    position: sticky;
    top: 0;
    z-index: 41;
  }

  /* ── Mega-menu backdrop ── */
  .mega-menu-backdrop {
    position: fixed;
    inset: 0;
    background: oklch(0.22 0.025 155 / 0.45);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity .25s ease,
      visibility 0s linear .25s;
    z-index: 38;
  }

  /* Shown while any top-level item with children is hovered or open */
  body:has(.header-menu__item--has-children:hover) .mega-menu-backdrop,
  body:has(.header-menu__item--has-children.is-open) .mega-menu-backdrop {
    opacity: 1;
    visibility: visible;
    transition:
      opacity .25s ease,
      visibility 0s linear 0s;
  }

  /* Mobile: never show the desktop mega-menu backdrop */
  @media screen and (max-width: 749px) {
    .mega-menu-backdrop { display: none; }
  }

  /* ── ① Top bar — lives outside the sticky <header> ── */
  /* Hidden on mobile: its contents (region, utility links) only show ≥750px,
     so the bar would otherwise render as an empty strip. */
  .header__row--topbar {
    display: none;
    background: var(--accent-deep);
    border-bottom: 1px solid oklch(1 0 0 / 0.12);
    width: 100%;
    position: relative;
    z-index: 41;
  }

  @media screen and (min-width: 750px) {
    .header__row--topbar {
      display: block;
    }
  }

  /* Light text on the deep-green top bar */
  .header__row--topbar .header-topbar__message,
  .header__row--topbar .header-topbar__utility-link,
  .header__row--topbar .region-selector__topbar-trigger {
    color: oklch(1 0 0 / 0.78);
  }

  .header__row--topbar .header-topbar__cta,
  .header__row--topbar .header-topbar__utility-link--active {
    color: var(--accent-ink);
  }

  .header__row--topbar .header-topbar__utility-link {
    border-left-color: oklch(1 0 0 / 0.18);
  }

  .header__row--topbar .header-topbar__utility-link:hover,
  .header__row--topbar .region-selector__topbar-trigger:hover {
    color: var(--accent-ink);
    background: oklch(1 0 0 / 0.1);
  }

  /* ── ② Main bar ── */
  .header__row--main {
    display: flex;
    align-items: center;
    min-height: var(--header-main-height);
  }

  .header__main-inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 20px;
    width: 100%;
    max-width: 1440px;
    margin-inline: auto;
    padding-inline: clamp(16px, 4vw, 32px);
  }

  [data-section-width='page-width'] .header__main-inner {
    max-width: 1280px;
  }

  [data-section-width='full-width'] .header__main-inner {
    max-width: 100%;
  }

  .header__col-logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .header__col-search {
    display: none;
    position: relative;
    min-width: 0;
    justify-content: center;
  }

  @media screen and (min-width: 750px) {
    .header__col-search {
      display: flex;
    }
  }

  .header__col-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
    justify-content: flex-end;
  }

  /* Inline search form */
  .header__inline-search {
    display: flex;
    align-items: center;
    width: 100%;
    max-width: 480px;
    background: var(--bg-card);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 0 4px 0 12px;
    gap: 8px;
    transition: border-color .15s ease, box-shadow .15s ease;
  }

  .header__inline-search:focus-within,
  .header__inline-search.is-active {
    border-color: var(--accent-deep);
    box-shadow: 0 0 0 3px oklch(0.55 0.18 155 / 0.14), 0 6px 18px -6px oklch(0.22 0.025 155 / 0.16);
    background: var(--bg);
  }

  /* ── Inline search results dropdown ── */
  .header__inline-search-results {
    position: absolute;
    top: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    max-width: 480px;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 12px;
    box-shadow:
      0 18px 40px -10px oklch(0.22 0.025 155 / 0.22),
      0 2px 6px -2px oklch(0.22 0.025 155 / 0.08);
    max-height: min(70vh, 560px);
    z-index: 50;
    padding: 8px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .header__inline-search-results[hidden] { display: none; }

  .header__inline-search-scroll {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--line) transparent;
    padding-right: 4px;
  }

  .header__inline-search-scroll::-webkit-scrollbar { width: 6px; }
  .header__inline-search-scroll::-webkit-scrollbar-thumb {
    background: var(--line);
    border-radius: 3px;
  }

  .header__inline-search-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .header__inline-search-item a {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 12px;
    align-items: center;
    padding: 8px 10px;
    border-radius: 10px;
    color: var(--ink);
    text-decoration: none;
    font-family: var(--font-sans);
    transition: background .15s ease, color .15s ease;
  }

  .header__inline-search-item a:hover,
  .header__inline-search-item a:focus-visible {
    background: var(--accent-soft);
    color: var(--accent-deep);
    outline: none;
  }

  .header__inline-search-thumb {
    width: 48px;
    height: 48px;
    border-radius: 8px;
    background: var(--bg-card);
    object-fit: cover;
    border: 1px solid var(--line);
    flex-shrink: 0;
  }

  .header__inline-search-thumb--ph {
    display: grid;
    place-items: center;
    color: var(--ink-mute);
  }

  .header__inline-search-item-title {
    font-size: 14px;
    font-weight: 500;
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }

  .header__inline-search-view-all {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 8px;
    padding: 12px 16px;
    background: var(--ink);
    color: var(--bg);
    border-radius: 10px;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    flex-shrink: 0;
    transition: opacity .15s ease, transform .15s ease;
  }

  .header__inline-search-view-all:hover,
  .header__inline-search-view-all:focus-visible {
    opacity: 0.9;
    outline: none;
  }

  .header__inline-search-empty {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 14px 12px;
    font-family: var(--font-sans);
    color: var(--ink);
    font-size: 13px;
    line-height: 1.5;
  }

  .header__inline-search-empty__title {
    font-weight: 600;
    color: var(--ink);
    font-size: 14px;
  }

  .header__inline-search-empty__lead {
    color: var(--ink-mute);
    font-size: 12px;
  }

  .header__inline-search-empty__list {
    margin: 0;
    padding-left: 18px;
    color: var(--ink-mute);
    font-size: 12px;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .header__inline-search-empty__list a {
    color: var(--accent-deep);
    text-decoration: none;
  }
  .header__inline-search-empty__list a:hover { text-decoration: underline; }

  /* Skeleton loading state — kept stable while debounce timer resets */
  .header__inline-search-skeleton {
    pointer-events: none;
  }

  .header__inline-search-skeleton-item {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 12px;
    align-items: center;
    padding: 8px 10px;
  }

  .header__inline-search-skeleton-thumb,
  .header__inline-search-skeleton-line,
  .header__inline-search-skeleton-cta {
    background: linear-gradient(
      90deg,
      var(--bg-card) 0%,
      oklch(0.92 0.01 155) 50%,
      var(--bg-card) 100%
    );
    background-size: 200% 100%;
    animation: header-search-shimmer 1.3s linear infinite;
    border-radius: 8px;
  }

  .header__inline-search-skeleton-thumb {
    width: 48px;
    height: 48px;
    border: 1px solid var(--line);
  }

  .header__inline-search-skeleton-line {
    height: 12px;
    width: 70%;
    border-radius: 6px;
  }

  .header__inline-search-skeleton-item:nth-child(2n) .header__inline-search-skeleton-line { width: 55%; }
  .header__inline-search-skeleton-item:nth-child(3n) .header__inline-search-skeleton-line { width: 80%; }
  .header__inline-search-skeleton-item:nth-child(5n) .header__inline-search-skeleton-line { width: 45%; }

  .header__inline-search-skeleton-cta {
    display: block;
    height: 44px;
    margin-top: 8px;
    border-radius: 10px;
    flex-shrink: 0;
  }

  @keyframes header-search-shimmer {
    from { background-position: 200% 0; }
    to   { background-position: -200% 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .header__inline-search-skeleton-thumb,
    .header__inline-search-skeleton-line,
    .header__inline-search-skeleton-cta {
      animation: none;
      background: var(--bg-card);
    }
  }

  .header__inline-search-error {
    padding: 14px 12px;
    color: oklch(0.50 0.13 30);
    font-size: 12px;
  }

  .header__inline-search-icon {
    color: var(--ink-mute);
    flex-shrink: 0;
  }

  .header__inline-search-input {
    flex: 1;
    min-width: 0;
    border: none;
    background: transparent;
    font-size: 14px;
    font-family: var(--font-sans);
    color: var(--ink);
    padding: 10px 0;
    outline: none;
  }

  .header__inline-search-input::placeholder {
    color: var(--ink-mute);
    transition: color .2s ease;
  }

  .header__inline-search-input::-webkit-search-cancel-button {
    display: none;
  }

  .header__inline-search-btn {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: var(--accent-deep);
    color: var(--accent-ink);
    border: none;
    border-radius: 7px;
    cursor: pointer;
    transition: opacity .15s ease;
  }

  .header__inline-search-btn:hover {
    opacity: 0.85;
  }

  /* ── ③ Nav bar ── */
  .header__row--nav {
    display: none;
    border-top: 1px solid var(--line);
    position: relative;
    min-height: var(--header-nav-height);
  }

  @media screen and (min-width: 750px) {
    .header__row--nav {
      display: flex;
      align-items: stretch;
    }
  }

  .header__nav-inner {
    display: flex;
    align-items: stretch;
    width: 100%;
    max-width: 1440px;
    margin-inline: auto;
    padding-inline: clamp(16px, 4vw, 32px);
  }

  [data-section-width='page-width'] .header__nav-inner {
    max-width: 1280px;
  }

  [data-section-width='full-width'] .header__nav-inner {
    max-width: 100%;
  }

  /* ── Action buttons ── */
  .header__search {
    display: none;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: var(--bg-card);
    color: var(--ink);
    cursor: pointer;
    transition: border-color .15s ease, background .15s ease, color .15s ease;
  }

  .header__search:hover {
    border-color: var(--accent-deep);
    background: var(--accent-soft);
    color: var(--accent-deep);
  }

  @media screen and (min-width: 750px) {
    .header__search {
      display: inline-flex;
    }
  }

  .header__account-wrapper {
    display: none;
    align-items: center;
    gap: 8px;
  }

  @media screen and (min-width: 750px) {
    .header__account-wrapper {
      display: flex;
    }
  }

  /* Bejelentkezve: köszöntő szöveg az avatar mellett (az avatar a kattintható elem).
     Nincs gap, mert az avatar-képnek alapból van saját paddingje. */
  .header__account-wrapper--signed-in {
    gap: 0;
  }

  .header__account-greeting {
    font-size: 13px;
    font-family: var(--font-sans);
    font-weight: 500;
    white-space: nowrap;
    color: var(--ink);
  }

  shopify-account {
    --shopify-account-dialog-position-top: var(--header-height);
    --shopify-account-color-background: var(--bg-card);
    --shopify-account-color-text: var(--ink);
    --shopify-account-color-accent: var(--accent-deep);
    --shopify-account-color-accent-text: var(--bg);
    --shopify-account-font-body: var(--font-sans);
    --shopify-account-font-body-weight: 400;
    --shopify-account-font-heading: var(--font-sans);
    --shopify-account-font-heading-weight: 600;
    --shopify-account-radius-base: 12px;
    --shopify-account-radius-button: 10px;
    --shopify-account-radius-input: 10px;
    --shopify-account-signed-in-avatar-size: 32px;
    --shopify-account-signed-in-avatar-color-background: var(--accent-deep);
    --shopify-account-signed-in-avatar-color-text: var(--bg);
  }

  .header__account {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 36px;
    padding: 0 14px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: var(--bg-card);
    color: var(--ink);
    font-size: 13px;
    font-family: var(--font-sans);
    font-weight: 500;
    cursor: pointer;
    transition: border-color .15s ease, background .15s ease, color .15s ease;
  }

  shopify-account:hover .header__account {
    border-color: var(--accent-deep);
    background: var(--accent-soft);
    color: var(--accent-deep);
  }

  .header__account-avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--accent-deep);
    color: var(--bg);
    font-size: 11px;
    font-weight: 700;
    flex-shrink: 0;
  }

  .header__account-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .header__account-label {
    white-space: nowrap;
  }

  .header__cart {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    text-decoration: none;
    color: var(--ink);
    padding: 0 12px;
    height: 36px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: var(--bg-card);
    font-size: 13px;
    font-family: var(--font-sans);
    font-weight: 500;
    transition: border-color .15s ease, background .15s ease, color .15s ease;
  }

  .header__cart:hover {
    border-color: var(--ink);
    background: var(--accent-soft);
  }

  @media screen and (min-width: 750px) {
    .header__cart {
      padding: 0 16px;
      color: var(--bg);
      border-color: var(--ink);
      background: var(--ink);
      transition: opacity .15s ease, transform .15s ease;
    }

    .header__cart:hover {
      opacity: 0.88;
      border-color: var(--ink);
      background: var(--ink);
    }
  }

  .header__cart-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .header__cart-label {
    display: none;
    white-space: nowrap;
  }

  @media screen and (min-width: 750px) {
    .header__cart-label {
      display: inline;
    }
  }

  .header__cart-count {
    background: var(--color-background);
    color: var(--color-foreground);
    font-size: 11px;
    font-weight: 600;
    padding: 2px 7px;
    border-radius: 999px;
    line-height: 1;
  }

  /* ── Geo-suggestion banner ── */
  .region-geo-banner {
    width: 100%;
    background: var(--accent-soft);
    border-bottom: 1px solid oklch(0.7 0.1 155 / 0.35);
    padding: 10px clamp(16px, 4vw, 32px);
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 13px;
    font-family: var(--font-sans);
    color: var(--accent-deep);
  }
  .region-geo-banner__text {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: 1;
    min-width: 0;
  }
  .region-geo-banner__actions {
    display: flex;
    gap: 8px;
    flex-shrink: 0;
  }
  .region-geo-banner__btn {
    padding: 5px 12px;
    border-radius: 999px;
    border: 1px solid currentColor;
    background: transparent;
    color: inherit;
    font-size: 12px;
    font-family: var(--font-sans);
    font-weight: 500;
    cursor: pointer;
    white-space: nowrap;
    transition: background .15s ease, color .15s ease;
  }
  .region-geo-banner__btn--confirm {
    background: var(--accent-deep);
    color: var(--accent-ink);
    border-color: var(--accent-deep);
  }
  .region-geo-banner__btn--confirm:hover { opacity: 0.85; }
  .region-geo-banner__btn--dismiss:hover {
    background: var(--accent-deep);
    color: var(--accent-ink);
  }

  /* Mobile-left column — only visible on mobile, contains hamburger + search */
  .header__col-mobile-left {
    display: none;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  @media screen and (max-width: 749px) {
    .header__col-mobile-left {
      display: flex;
    }

    /* Center logo within its 1fr column on mobile */
    .header__col-logo {
      justify-content: center;
    }
  }

  /* Hamburger and mobile-search triggers — shared button style */
  .sw-mobile-nav-trigger,
  .sw-mobile-search-trigger {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: var(--bg-card);
    color: var(--ink);
    cursor: pointer;
    flex-shrink: 0;
    transition: border-color .15s ease, background .15s ease;
  }
  .sw-mobile-nav-trigger:hover,
  .sw-mobile-search-trigger:hover {
    border-color: var(--ink);
    background: var(--accent-soft);
  }

  /* Hidden localization form */
  #region-localization-form { display: none; }
{% endstylesheet %}

{%- render 'predictive-search' -%}
{%- render 'mobile-nav-drawer', menu: mobile_menu, utility_menu: mobile_utility_menu -%}
{%- render 'region-selector', variant: 'modal' -%}

{%- comment -%} Single localization form — used by all region-selector variants via JS {%- endcomment -%}
{%- form 'localization', id: 'region-localization-form' -%}
  <input type="hidden" name="country_code" id="region-localization-country" value="{{ localization.country.iso_code }}">
  <input type="hidden" name="language_code" id="region-localization-language" value="{{ localization.language.iso_code }}">
{%- endform -%}

<script src="{{ 'mobile-nav.js' | asset_url }}" defer></script>
<script src="{{ 'region-selector.js' | asset_url }}" defer></script>
<script src="{{ 'header.js' | asset_url }}" defer></script>
{% schema %}
{
  "name": "Header",
  "class": "header-section",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_header",
      "label": "Enable sticky header",
      "default": true
    },
    {
      "type": "header",
      "content": "Search"
    },
    {
      "type": "checkbox",
      "id": "enable_inline_search",
      "label": "Inline search bar",
      "info": "Show a full search bar in the main header row instead of a search icon.",
      "default": true
    },
    {
      "type": "header",
      "content": "Top bar"
    },
    {
      "type": "checkbox",
      "id": "enable_top_bar",
      "label": "Show top bar",
      "default": false
    },
    {
      "type": "header",
      "content": "Account"
    },
    {
      "type": "paragraph",
      "content": "Manage your customer accounts settings in your store admin."
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "Menu",
      "default": "customer-account-main-menu"
    }
  ]
}
{% endschema %}
