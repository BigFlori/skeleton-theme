{%- liquid
  if section.settings.collection != blank
    assign grid_collection = section.settings.collection
  else
    assign grid_collection = collections['recommended-products']
  endif
  assign limit = 8
-%}

<section class="sw-prodgrid full-width">
  <div class="container">

    <div class="sw-prodgrid__header">
      <div>
        <span class="eyebrow">{{ 'sections.product_grid.eyebrow' | t }}</span>
        <h2 class="display sw-prodgrid__headline">{{ 'sections.product_grid.title' | t }}</h2>
      </div>
    </div>

    <div class="sw-prodgrid__grid">
      {%- if grid_collection != blank and grid_collection.products.size > 0 -%}
        {%- for product in grid_collection.products limit: limit -%}
          {%- render 'collection-product-card', product: product -%}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..limit) -%}
          <article class="prod-card">
            <div class="prod-card__img-wrap">
              {{ 'product-' | append: i | placeholder_svg_tag: 'prod-card__img' }}
            </div>
            <p class="prod-card__vendor">{{ 'general.onboarding.product_vendor' | t }}</p>
            <p class="prod-card__title">{{ 'general.onboarding.product_title' | t }}</p>
            <div class="prod-card__footer">
              <div class="prod-card__price-block">
                <span class="display prod-card__price">€ 0.000</span>
              </div>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>

  </div>
</section>

<script src="{{ 'collection.js' | asset_url }}" defer></script>

{% stylesheet %}
.sw-prodgrid {
  padding: var(--s-5) 0;
  background: var(--bg);
}

.sw-prodgrid + .sw-prodgrid {
  border-top: 1px solid var(--line);
}

.sw-prodgrid__header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 24px;
  margin-bottom: var(--s-4);
  flex-wrap: wrap;
}

.sw-prodgrid__headline {
  font-size: clamp(28px, 4vw, 52px);
  line-height: 1.05;
  margin: 10px 0 0;
}

.sw-prodgrid__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
}

/* prod-card — used on collection page too; included here for homepage */
.prod-card {
  position: relative;
  background: var(--bg-card);
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  padding: 14px;
  display: flex;
  flex-direction: column;
  transition: border-color .2s ease, transform .2s ease;
  cursor: pointer;
}
.prod-card:hover { border-color: var(--accent); transform: translateY(-2px); }

.prod-card__overlay-link {
  position: absolute;
  inset: 0;
  border-radius: inherit;
  z-index: 1;
}
.prod-card__img-wrap {
  position: relative;
  aspect-ratio: 1 / 1;
  border-radius: calc(var(--radius-lg) - 6px);
  overflow: hidden;
  margin-bottom: 14px;
  background: var(--bg-warm);
}
.prod-card__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.prod-card__disc-badge {
  position: absolute;
  top: 10px;
  left: 10px;
  background: var(--sale);
  color: oklch(0.98 0.01 90);
  font-size: 11px;
  font-weight: 500;
  padding: 3px 7px;
  border-radius: 4px;
  letter-spacing: 0.02em;
  z-index: 2;
}
.prod-card__brand-badge {
  position: absolute;
  top: 10px;
  right: 10px;
  background: oklch(0.99 0.005 90 / 0.9);
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
  color: var(--ink-soft);
  font-size: 9px;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  padding: 4px 7px;
  border-radius: 4px;
  z-index: 2;
}
.prod-card__atc-btn {
  position: absolute;
  left: 10px;
  right: 10px;
  bottom: 10px;
  background: var(--ink);
  color: oklch(0.96 0.01 90);
  border: none;
  border-radius: 8px;
  padding: 10px 14px;
  font-size: 13px;
  font-weight: 500;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  text-decoration: none;
  z-index: 2;
  opacity: 0;
  transform: translateY(8px);
  transition: opacity .2s ease, transform .2s ease, background .15s ease;
}
.prod-card__atc-btn--select { background: var(--accent-deep); }
.prod-card:hover .prod-card__atc-btn { opacity: 1; transform: translateY(0); }
.prod-card__atc-btn:disabled { opacity: 0.6; cursor: not-allowed; }

.prod-card__vendor {
  font-size: 10px;
  color: var(--ink-mute);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin-bottom: 4px;
}
.prod-card__title {
  font-size: 15px;
  font-weight: 500;
  color: var(--ink);
  line-height: 1.3;
  min-height: 39px;
}
.prod-card__spec {
  font-size: 11px;
  color: var(--ink-mute);
  margin-top: 4px;
  margin-bottom: 8px;
  letter-spacing: 0.02em;
}
.prod-card__footer {
  padding-top: 8px;
  border-top: 1px dashed var(--line);
  margin-top: auto;
}
.prod-card__price-block {
  display: flex;
  align-items: baseline;
  gap: 6px;
  flex-wrap: wrap;
}
.prod-card__price { font-size: 22px; line-height: 1; }
.prod-card__old-price {
  font-size: 11px;
  color: var(--ink-mute);
  text-decoration: line-through;
}
.prod-card__stock {
  font-size: 10px;
  margin-top: 6px;
  display: flex;
  align-items: center;
  gap: 6px;
  letter-spacing: 0.02em;
}
.prod-card__stock-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  flex-shrink: 0;
  display: inline-block;
}

@media (max-width: 960px) {
  .sw-prodgrid__grid { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 540px) {
  .sw-prodgrid__grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Product Grid",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    }
  ],
  "presets": [
    {
      "name": "Product Grid"
    }
  ]
}
{% endschema %}
