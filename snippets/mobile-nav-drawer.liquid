{% comment %}
  Mobile Navigation Drawer — slide-in drawer with multi-level drill-down.
  Items with children show a right chevron; tapping slides the submenu in
  from the right (as if entering that menu item). A back bar returns one level.
  Panels are rendered as flat siblings inside the viewport and linked by id;
  navigation state is handled in assets/mobile-nav.js.
  Opened by [data-mobile-nav-trigger] in the header.
{% endcomment %}

{%- liquid
  assign nav_menu = menu | default: linklists['main-menu']
-%}

{%- comment -%} ── Backdrop ── {%- endcomment -%}
<div class="sw-mobile-nav-backdrop" data-mobile-nav-backdrop aria-hidden="true"></div>

{%- comment -%} ── Drawer panel ── {%- endcomment -%}
<nav
  id="sw-mobile-nav"
  class="sw-mobile-nav"
  role="dialog"
  aria-modal="true"
  aria-label="{{ 'general.header' | t }}"
  aria-hidden="true"
>

  <header class="sw-mobile-nav__header">
    <div>
      <span class="mono sw-mobile-nav__eyebrow">{{ 'general.menu' | t | default: 'Menu' }}</span>
      <p class="display sw-mobile-nav__title">{{ shop.name }}</p>
    </div>
    <button
      type="button"
      class="sw-mobile-nav__close"
      data-mobile-nav-close
      aria-label="{{ 'sections.cart_drawer.close' | t }}"
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        {%- render 'icon', icon: 'close' -%}
      </svg>
    </button>
  </header>

  {%- comment -%} ── Drill-down viewport ── {%- endcomment -%}
  <div class="sw-mobile-nav__viewport" data-mobile-nav-viewport>

    {%- comment -%} ── Root panel ── {%- endcomment -%}
    <div class="sw-mobile-nav__panel sw-mobile-nav__panel--root is-active" data-panel-id="root">
      <ul class="sw-mobile-nav__list" role="list">
        {%- for link in nav_menu.links -%}
          <li class="sw-mobile-nav__item">
            {%- if link.links.size > 0 -%}
              <button
                type="button"
                class="sw-mobile-nav__drill"
                data-panel-target="p-{{ forloop.index }}"
                aria-expanded="false"
              >
                <span class="sw-mobile-nav__link-text">{{ link.title }}</span>
                <svg class="sw-mobile-nav__drill-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  {%- render 'icon', icon: 'chevron-right' -%}
                </svg>
              </button>
            {%- else -%}
              <a
                href="{{ link.url }}"
                class="sw-mobile-nav__link{% if link.current %} sw-mobile-nav__link--active{% endif %}"
                {% if link.current %}aria-current="page"{% endif %}
              >
                <span class="sw-mobile-nav__link-text">{{ link.title }}</span>
              </a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>

      {%- if shop.customer_accounts_enabled -%}
        <div class="sw-mobile-nav__account">
          <a href="{{ routes.account_url }}" class="sw-mobile-nav__account-link">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              {%- render 'icon', icon: 'user' -%}
            </svg>
            <span>{{ 'general.account' | t }}</span>
          </a>
        </div>
      {%- endif -%}

      {%- render 'region-selector', variant: 'drawer' -%}
    </div>

    {%- comment -%} ── Sub-panels (flat siblings, linked by id) ── {%- endcomment -%}
    {%- for link in nav_menu.links -%}
      {%- if link.links.size > 0 -%}
        {%- assign p1 = forloop.index -%}
        <div class="sw-mobile-nav__panel" data-panel-id="p-{{ p1 }}" data-panel-parent="root">
          <button type="button" class="sw-mobile-nav__back" data-panel-back>
            <svg class="sw-mobile-nav__back-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              {%- render 'icon', icon: 'chevron-right' -%}
            </svg>
            <span>{{ 'navigation.back' | t }}</span>
          </button>
          <h2 class="sw-mobile-nav__panel-title">{{ link.title }}</h2>
          <ul class="sw-mobile-nav__list" role="list">
            {%- comment -%} Highlighted link to the parent category page itself {%- endcomment -%}
            {%- unless link.url == '#' or link.url == 'javascript:void(0)' -%}
              <li class="sw-mobile-nav__item sw-mobile-nav__item--all">
                <a
                  href="{{ link.url }}"
                  class="sw-mobile-nav__all{% if link.current %} sw-mobile-nav__all--active{% endif %}"
                  {% if link.current %}aria-current="page"{% endif %}
                >
                  <span class="sw-mobile-nav__link-text">{{ 'navigation.all_in' | t: category: link.title }}</span>
                  <svg class="sw-mobile-nav__all-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    {%- render 'icon', icon: 'arrow-right' -%}
                  </svg>
                </a>
              </li>
            {%- endunless -%}
            {%- for child in link.links -%}
              <li class="sw-mobile-nav__item">
                {%- if child.links.size > 0 -%}
                  <button
                    type="button"
                    class="sw-mobile-nav__drill"
                    data-panel-target="p-{{ p1 }}-{{ forloop.index }}"
                    aria-expanded="false"
                  >
                    <span class="sw-mobile-nav__link-text">{{ child.title }}</span>
                    <svg class="sw-mobile-nav__drill-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      {%- render 'icon', icon: 'chevron-right' -%}
                    </svg>
                  </button>
                {%- else -%}
                  <a
                    href="{{ child.url }}"
                    class="sw-mobile-nav__link{% if child.current %} sw-mobile-nav__link--active{% endif %}"
                    {% if child.current %}aria-current="page"{% endif %}
                  >
                    <span class="sw-mobile-nav__link-text">{{ child.title }}</span>
                  </a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </div>

        {%- comment -%} ── 3rd-level panels ── {%- endcomment -%}
        {%- for child in link.links -%}
          {%- if child.links.size > 0 -%}
            <div class="sw-mobile-nav__panel" data-panel-id="p-{{ p1 }}-{{ forloop.index }}" data-panel-parent="p-{{ p1 }}">
              <button type="button" class="sw-mobile-nav__back" data-panel-back>
                <svg class="sw-mobile-nav__back-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  {%- render 'icon', icon: 'chevron-right' -%}
                </svg>
                <span>{{ 'navigation.back' | t }}</span>
              </button>
              <h2 class="sw-mobile-nav__panel-title">{{ child.title }}</h2>
              <ul class="sw-mobile-nav__list" role="list">
                {%- unless child.url == '#' or child.url == 'javascript:void(0)' -%}
                  <li class="sw-mobile-nav__item sw-mobile-nav__item--all">
                    <a
                      href="{{ child.url }}"
                      class="sw-mobile-nav__all{% if child.current %} sw-mobile-nav__all--active{% endif %}"
                      {% if child.current %}aria-current="page"{% endif %}
                    >
                      <span class="sw-mobile-nav__link-text">{{ 'navigation.all_in' | t: category: child.title }}</span>
                      <svg class="sw-mobile-nav__all-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        {%- render 'icon', icon: 'arrow-right' -%}
                      </svg>
                    </a>
                  </li>
                {%- endunless -%}
                {%- for grandchild in child.links -%}
                  <li class="sw-mobile-nav__item">
                    <a
                      href="{{ grandchild.url }}"
                      class="sw-mobile-nav__link{% if grandchild.current %} sw-mobile-nav__link--active{% endif %}"
                      {% if grandchild.current %}aria-current="page"{% endif %}
                    >
                      <span class="sw-mobile-nav__link-text">{{ grandchild.title }}</span>
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    {%- endfor -%}

  </div>

</nav>

{% stylesheet %}

[hidden] { display: none !important; }

/* ── Backdrop ── */
.sw-mobile-nav-backdrop {
  display: none;
  position: fixed;
  inset: 0;
  background: oklch(0.22 0.025 155 / 0.45);
  backdrop-filter: blur(3px);
  -webkit-backdrop-filter: blur(3px);
  opacity: 0;
  pointer-events: none;
  transition: opacity .25s ease;
  z-index: 90;
}
.sw-mobile-nav-backdrop.is-open {
  opacity: 1;
  pointer-events: auto;
}

/* ── Drawer panel ── */
.sw-mobile-nav {
  display: none;
  position: fixed;
  top: 0;
  left: 0;
  bottom: 0;
  width: min(340px, 88vw);
  background: var(--bg);
  transform: translateX(-100%);
  transition: transform .35s cubic-bezier(.2,.8,.2,1);
  z-index: 91;
  flex-direction: column;
  overflow: hidden;
}
.sw-mobile-nav.is-open {
  transform: translateX(0);
  box-shadow: 30px 0 60px -20px oklch(0.22 0.025 155 / 0.25);
}

@media screen and (max-width: 749px) {
  .sw-mobile-nav-backdrop { display: block; }
  .sw-mobile-nav { display: flex; }
}

/* ── Header ── */
.sw-mobile-nav__header {
  padding: 22px 26px 18px;
  border-bottom: 1px solid var(--line);
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
}
.sw-mobile-nav__eyebrow {
  display: block;
  font-size: 10px;
  color: var(--ink-mute);
  letter-spacing: 0.06em;
  text-transform: uppercase;
}
.sw-mobile-nav__title {
  font-size: 26px;
  line-height: 1.1;
  margin-top: 6px;
  margin-bottom: 0;
}
.sw-mobile-nav__close {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  border: 1px solid var(--line);
  background: var(--bg-card);
  cursor: pointer;
  display: grid;
  place-items: center;
  color: var(--ink);
  flex-shrink: 0;
  transition: border-color .15s ease;
}
.sw-mobile-nav__close:hover { border-color: var(--ink); }

/* ── Drill-down viewport ── */
.sw-mobile-nav__viewport {
  position: relative;
  flex: 1;
  overflow: hidden;
}

/* Each level is a full-size panel. Resting positions, all driven from JS via
   the stack (see mobile-nav.js):
     • active panel  → translateX(0)      on screen
     • parent panels → translateX(-25%)   slid partly left (iOS-style parallax)
     • the rest      → translateX(100%)   parked off-screen right
   Drilling in slides the parent left while the child slides in over it; going
   back reverses it. Panels stay rendered the whole time — only the transform
   animates — so the slide fires reliably. Interactivity/focus of hidden panels
   is handled with the `inert` attribute (not CSS visibility, which used to kill
   the animation when toggled in the same frame as the transform). The
   viewport's overflow:hidden clips the parked panels. */
.sw-mobile-nav__panel {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  background: var(--bg);
  overflow-y: auto;
  overscroll-behavior: contain;
  transform: translateX(100%);
  will-change: transform;
  backface-visibility: hidden;
  transition: transform .32s cubic-bezier(.2,.8,.2,1);
}
.sw-mobile-nav__panel.is-active {
  transform: translateX(0);
}
/* Ancestor of the active panel — slid partly left so it parallaxes behind the
   incoming child (higher specificity than --root, so root parallaxes too). */
.sw-mobile-nav__panel.is-parent {
  transform: translateX(-25%);
}
/* Root's resting position when it is itself the active level. */
.sw-mobile-nav__panel--root {
  transform: translateX(0);
}

@media (prefers-reduced-motion: reduce) {
  .sw-mobile-nav__panel { transition: none; }
}

/* ── Back bar (step up one level) ── */
.sw-mobile-nav__back {
  position: sticky;
  top: 0;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 4px;
  width: 100%;
  padding: 18px 26px 6px;
  background: var(--bg);
  border: none;
  cursor: pointer;
  color: var(--accent-deep);
  font-family: var(--font-sans);
  font-size: 14px;
  font-weight: 600;
  text-align: left;
  flex-shrink: 0;
  transition: opacity .15s ease;
}
.sw-mobile-nav__back:hover { opacity: 0.7; }
.sw-mobile-nav__back-icon {
  transform: scaleX(-1);
  flex-shrink: 0;
  margin-left: -4px;
}

/* ── Panel title (category name) ── */
.sw-mobile-nav__panel-title {
  margin: 0;
  padding: 18px 26px 16px;
  font-family: var(--font-sans);
  font-size: 22px;
  font-weight: 700;
  line-height: 1.15;
  color: var(--ink);
  border-bottom: 1px solid var(--line);
  flex-shrink: 0;
}

/* ── Nav list ── */
.sw-mobile-nav__list {
  list-style: none;
  margin: 0;
  padding: 8px 0;
  flex: 1;
}
/* Small breathing room below the title divider before the first row. */
.sw-mobile-nav__panel:not(.sw-mobile-nav__panel--root) .sw-mobile-nav__list {
  padding-top: 12px;
}
.sw-mobile-nav__item {
  border-bottom: 1px solid var(--line-soft, var(--line));
}
.sw-mobile-nav__item:first-child {
  border-top: none;
}

/* Shared row appearance for links and drill buttons */
.sw-mobile-nav__link,
.sw-mobile-nav__drill {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding: 18px 26px;
  color: var(--ink);
  text-decoration: none;
  font-size: 17px;
  font-family: var(--font-sans);
  font-weight: 400;
  gap: 12px;
  transition: background .15s ease, color .15s ease;
}
.sw-mobile-nav__drill {
  background: none;
  border: none;
  cursor: pointer;
  text-align: left;
}
.sw-mobile-nav__link:hover,
.sw-mobile-nav__drill:hover {
  background: var(--accent-soft);
  color: var(--accent-deep);
}
.sw-mobile-nav__link--active {
  font-weight: 600;
  color: var(--accent-deep);
}
.sw-mobile-nav__link-text {
  flex: 1;
  min-width: 0;
}
.sw-mobile-nav__drill-arrow {
  color: var(--ink-mute);
  flex-shrink: 0;
  transition: color .15s ease, transform .15s ease;
}
.sw-mobile-nav__drill:hover .sw-mobile-nav__drill-arrow {
  color: var(--accent-deep);
  transform: translateX(3px);
}

/* ── Highlighted "All in …" row (first row of a sub-panel) ── */
.sw-mobile-nav__all {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  width: 100%;
  padding: 17px 26px;
  background: color-mix(in oklab, var(--ink) 5%, transparent);
  color: var(--accent-deep);
  text-decoration: none;
  font-family: var(--font-sans);
  font-size: 16px;
  font-weight: 600;
  transition: background .15s ease;
}
.sw-mobile-nav__all:hover {
  background: color-mix(in oklab, var(--ink) 9%, transparent);
}
.sw-mobile-nav__all--active {
  background: var(--accent-soft);
}
.sw-mobile-nav__all-arrow {
  color: var(--accent-deep);
  flex-shrink: 0;
  transition: transform .15s ease;
}
.sw-mobile-nav__all:hover .sw-mobile-nav__all-arrow {
  transform: translateX(3px);
}

/* ── Account section ── */
.sw-mobile-nav__account {
  padding: 16px 26px;
  border-top: 1px solid var(--line);
  flex-shrink: 0;
}
.sw-mobile-nav__account-link {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 10px 16px;
  border-radius: 999px;
  border: 1px solid var(--line);
  background: var(--bg-card);
  color: var(--ink);
  text-decoration: none;
  font-size: 14px;
  font-family: var(--font-sans);
  font-weight: 500;
  transition: border-color .15s ease, background .15s ease, color .15s ease;
}
.sw-mobile-nav__account-link:hover {
  border-color: var(--accent-deep);
  background: var(--accent-soft);
  color: var(--accent-deep);
}

/* ── Region label ── */
.sw-mobile-nav__lang-label {
  display: block;
  font-size: 10px;
  color: var(--ink-mute);
  letter-spacing: 0.06em;
  text-transform: uppercase;
  margin-bottom: 12px;
}

{% endstylesheet %}
