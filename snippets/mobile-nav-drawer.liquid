{% comment %}
  Mobile Navigation Drawer — slide-in from left, only visible on mobile.
  Visual style matches the cart-drawer (sw-cart-drawer).
  Opened by [data-mobile-nav-trigger] in the header.
  JS: assets/mobile-nav.js
{% endcomment %}

{%- liquid
  assign nav_menu = menu | default: linklists['main-menu']
-%}

{%- comment -%} ── Backdrop ── {%- endcomment -%}
<div class="sw-mobile-nav-backdrop" data-mobile-nav-backdrop aria-hidden="true"></div>

{%- comment -%} ── Drawer panel ── {%- endcomment -%}
<nav
  id="sw-mobile-nav"
  class="sw-mobile-nav"
  role="dialog"
  aria-modal="true"
  aria-label="{{ 'general.header' | t }}"
  aria-hidden="true"
>

  {%- comment -%} Header {%- endcomment -%}
  <header class="sw-mobile-nav__header">
    <div>
      <span class="mono sw-mobile-nav__eyebrow">{{ 'general.menu' | t | default: 'Menu' }}</span>
      <p class="display sw-mobile-nav__title">{{ shop.name }}</p>
    </div>
    <button
      type="button"
      class="sw-mobile-nav__close"
      data-mobile-nav-close
      aria-label="{{ 'sections.cart_drawer.close' | t }}"
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        {%- render 'icon', icon: 'close' -%}
      </svg>
    </button>
  </header>

  {%- comment -%} ── Navigation links ── {%- endcomment -%}
  <ul class="sw-mobile-nav__list" role="list">
    {%- for link in nav_menu.links -%}
      <li class="sw-mobile-nav__item">
        <a
          href="{{ link.url }}"
          class="sw-mobile-nav__link{% if link.current %} sw-mobile-nav__link--active{% endif %}"
          {% if link.current %}aria-current="page"{% endif %}
        >
          <span class="sw-mobile-nav__link-text">{{ link.title }}</span>
          <svg class="sw-mobile-nav__link-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            {%- render 'icon', icon: 'arrow-right' -%}
          </svg>
        </a>
      </li>
    {%- endfor -%}
  </ul>

  {%- if shop.customer_accounts_enabled -%}
    <div class="sw-mobile-nav__account">
      <a href="{{ routes.account_url }}" class="sw-mobile-nav__account-link">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          {%- render 'icon', icon: 'user' -%}
        </svg>
        <span>{{ 'general.account' | t }}</span>
      </a>
    </div>
  {%- endif -%}

  {%- if localization.available_languages.size > 1 -%}
    <div class="sw-mobile-nav__lang">
      <span class="mono sw-mobile-nav__lang-label">{{ 'general.language' | t }}</span>
      <div class="sw-mobile-nav__lang-options">
        {%- for language in localization.available_languages -%}
          {%- form 'localization' -%}
            <input type="hidden" name="language_code" value="{{ language.iso_code }}">
            <button
              type="submit"
              class="sw-mobile-nav__lang-btn{% if language.iso_code == localization.language.iso_code %} sw-mobile-nav__lang-btn--active{% endif %}"
            >
              {{ language.endonym_name }}
            </button>
          {%- endform -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

</nav>

{% stylesheet %}

[hidden] { display: none !important; }

/* ── Backdrop ── */
.sw-mobile-nav-backdrop {
  display: none;
  position: fixed;
  inset: 0;
  background: oklch(0.22 0.025 155 / 0.45);
  backdrop-filter: blur(3px);
  -webkit-backdrop-filter: blur(3px);
  opacity: 0;
  pointer-events: none;
  transition: opacity .25s ease;
  z-index: 90;
}
.sw-mobile-nav-backdrop.is-open {
  opacity: 1;
  pointer-events: auto;
}

/* ── Drawer panel ── */
.sw-mobile-nav {
  display: none;
  position: fixed;
  top: 0;
  left: 0;
  bottom: 0;
  width: min(340px, 88vw);
  background: var(--bg);
  transform: translateX(-100%);
  transition: transform .35s cubic-bezier(.2,.8,.2,1);
  z-index: 91;
  flex-direction: column;
  overflow-y: auto;
  overscroll-behavior: contain;
}
.sw-mobile-nav.is-open {
  transform: translateX(0);
  box-shadow: 30px 0 60px -20px oklch(0.22 0.025 155 / 0.25);
}

/* Only active on mobile */
@media screen and (max-width: 749px) {
  .sw-mobile-nav-backdrop { display: block; }
  .sw-mobile-nav { display: flex; }
}

/* ── Header ── */
.sw-mobile-nav__header {
  padding: 22px 26px 18px;
  border-bottom: 1px solid var(--line);
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
}
.sw-mobile-nav__eyebrow {
  display: block;
  font-size: 10px;
  color: var(--ink-mute);
  letter-spacing: 0.06em;
  text-transform: uppercase;
}
.sw-mobile-nav__title {
  font-size: 26px;
  line-height: 1.1;
  margin-top: 6px;
  margin-bottom: 0;
}
.sw-mobile-nav__close {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  border: 1px solid var(--line);
  background: var(--bg-card);
  cursor: pointer;
  display: grid;
  place-items: center;
  color: var(--ink);
  flex-shrink: 0;
  transition: border-color .15s ease;
}
.sw-mobile-nav__close:hover { border-color: var(--ink); }

/* ── Nav list ── */
.sw-mobile-nav__list {
  list-style: none;
  margin: 0;
  padding: 8px 0;
  flex: 1;
}
.sw-mobile-nav__item {
  border-bottom: 1px solid var(--line-soft, var(--line));
}
.sw-mobile-nav__item:first-child {
  border-top: none;
}
.sw-mobile-nav__link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 26px;
  color: var(--ink);
  text-decoration: none;
  font-size: 17px;
  font-family: var(--font-sans);
  font-weight: 400;
  transition: background .15s ease, color .15s ease;
  gap: 12px;
}
.sw-mobile-nav__link:hover {
  background: var(--accent-soft);
  color: var(--accent-deep);
}
.sw-mobile-nav__link--active {
  font-weight: 600;
  color: var(--accent-deep);
}
.sw-mobile-nav__link-text {
  flex: 1;
  min-width: 0;
}
.sw-mobile-nav__link-arrow {
  color: var(--ink-mute);
  flex-shrink: 0;
  transition: color .15s ease, transform .15s ease;
}
.sw-mobile-nav__link:hover .sw-mobile-nav__link-arrow {
  color: var(--accent-deep);
  transform: translateX(3px);
}

/* ── Account section ── */
.sw-mobile-nav__account {
  padding: 16px 26px;
  border-top: 1px solid var(--line);
  flex-shrink: 0;
}
.sw-mobile-nav__account-link {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 10px 16px;
  border-radius: 999px;
  border: 1px solid var(--line);
  background: var(--bg-card);
  color: var(--ink);
  text-decoration: none;
  font-size: 14px;
  font-family: var(--font-sans);
  font-weight: 500;
  transition: border-color .15s ease, background .15s ease, color .15s ease;
}
.sw-mobile-nav__account-link:hover {
  border-color: var(--accent-deep);
  background: var(--accent-soft);
  color: var(--accent-deep);
}

/* ── Language section (drawer footer) ── */
.sw-mobile-nav__lang {
  padding: 20px 26px;
  border-top: 1px solid var(--line);
  flex-shrink: 0;
}
.sw-mobile-nav__lang-label {
  display: block;
  font-size: 10px;
  color: var(--ink-mute);
  letter-spacing: 0.06em;
  text-transform: uppercase;
  margin-bottom: 12px;
}
.sw-mobile-nav__lang-options {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.sw-mobile-nav__lang-btn {
  padding: 7px 14px;
  border-radius: 999px;
  border: 1px solid var(--line);
  background: var(--bg-card);
  color: var(--ink);
  font-size: 13px;
  font-family: var(--font-sans);
  font-weight: 500;
  cursor: pointer;
  transition: border-color .15s ease, background .15s ease, color .15s ease;
}
.sw-mobile-nav__lang-btn:hover {
  border-color: var(--accent-deep);
  background: var(--accent-soft);
  color: var(--accent-deep);
}
.sw-mobile-nav__lang-btn--active {
  border-color: var(--accent-deep);
  background: var(--accent-deep);
  color: var(--accent-ink);
  font-weight: 600;
}

/* ── Hamburger button (in header) ── */
.sw-mobile-nav-trigger {
  display: none;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  border-radius: 12px;
  border: 1px solid var(--line);
  background: var(--bg-card);
  color: var(--ink);
  cursor: pointer;
  flex-shrink: 0;
  transition: border-color .15s ease, background .15s ease;
}
.sw-mobile-nav-trigger:hover {
  border-color: var(--ink);
  background: var(--accent-soft);
}

@media screen and (max-width: 749px) {
  .sw-mobile-nav-trigger {
    display: flex;
  }
}

{% endstylesheet %}
