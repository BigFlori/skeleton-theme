{%- assign datasheet = product.metafields.custom.datasheet.value -%}
{%- assign tech_badge = datasheet.tech_badge -%}
<div class="pdp-gallery-sticky">
  <div>
    <!-- Main image -->
    <div class="pdp-gallery__main">
      {%- if product.images.size > 0 -%}
        <img
          id="pdp-main-img"
          src="{{ product.images[0] | image_url: width: 800, format: 'webp' }}"
          srcset="{{ product.images[0] | image_url: width: 400, format: 'webp' }} 400w,
                  {{ product.images[0] | image_url: width: 600, format: 'webp' }} 600w,
                  {{ product.images[0] | image_url: width: 800, format: 'webp' }} 800w,
                  {{ product.images[0] | image_url: width: 1200, format: 'webp' }} 1200w,
                  {{ product.images[0] | image_url: width: 1600, format: 'webp' }} 1600w"
          sizes="(max-width: 960px) 100vw, (max-width: 1280px) 55vw, 680px"
          alt="{{ product.images[0].alt | default: product.title | escape }}"
          width="800" height="800"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="pdp-gallery__img"
        >
      {%- else -%}
        <div class="pdp-gallery__empty" role="img" aria-label="{{ 'pdp.gallery.no_image' | t | default: 'Nincs elérhető kép' }}">
          <span class="pdp-gallery__empty-text">{{ 'pdp.gallery.no_image' | t | default: 'Nincs elérhető kép' }}</span>
        </div>
      {%- endif -%}

      <div class="pdp-gallery__badges">
        {%- if tech_badge != blank -%}
          <span class="pdp-gallery__badge pdp-gallery__badge--dark">{{ tech_badge }}</span>
        {%- endif -%}
        {%- if current_variant.available -%}
          <span class="pdp-gallery__badge pdp-gallery__badge--sun">{{ 'pdp.gallery.in_stock' | t }}</span>
        {%- else -%}
          <span class="pdp-gallery__badge" style="background:oklch(0.92 0.06 30);color:var(--ink);">{{ 'pdp.gallery.sold_out' | t }}</span>
        {%- endif -%}
      </div>

      <button class="pdp-gallery__zoom" type="button" aria-label="{{ 'pdp.gallery.zoom_label' | t }}" id="pdp-zoom-btn">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="10" cy="10" r="7"/><path d="M15 15l6 6"/></svg>
        {{ 'pdp.gallery.zoom' | t }}
      </button>
    </div>

    <!-- Thumbnails -->
    {%- if product.images.size > 1 -%}
      <div class="pdp-gallery__thumbs">
        {%- for image in product.images -%}
          <button
            class="pdp-gallery__thumb{% if forloop.first %} is-active{% endif %}"
            type="button"
            data-idx="{{ forloop.index0 }}"
            data-image-id="{{ image.id }}"
            data-src="{{ image | image_url: width: 800, format: 'webp' }}"
            data-srcset="{{ image | image_url: width: 400, format: 'webp' }} 400w, {{ image | image_url: width: 600, format: 'webp' }} 600w, {{ image | image_url: width: 800, format: 'webp' }} 800w, {{ image | image_url: width: 1200, format: 'webp' }} 1200w, {{ image | image_url: width: 1600, format: 'webp' }} 1600w"
            data-alt="{{ image.alt | default: product.title | escape }}"
            data-label="{{ image.alt | default: forloop.index }}"
            aria-label="{% if image.alt != blank %}{{ image.alt | escape }}{% else %}{{ forloop.index }}{% endif %}"
          >
            <img
              src="{{ image | image_url: width: 160, format: 'webp' }}"
              srcset="{{ image | image_url: width: 160, format: 'webp' }} 1x, {{ image | image_url: width: 320, format: 'webp' }} 2x"
              alt="{{ image.alt | default: product.title | escape }}"
              width="160" height="160" loading="lazy" decoding="async"
            >
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</div>

{%- if product.images.size > 0 -%}
  <script id="pdp-gallery-data" type="application/json">
    [
      {%- for image in product.images -%}
        {"src":{{ image | image_url: width: 1600 | json }},"alt":{{ image.alt | default: product.title | json }}}{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  </script>

  <div class="pdp-lightbox" id="pdp-lightbox" role="dialog" aria-modal="true" aria-label="{{ 'pdp.gallery.zoom_label' | t }}" aria-hidden="true">
    <button class="pdp-lightbox__close" type="button" id="pdp-lightbox-close" aria-label="{{ 'pdp.gallery.close' | t }}">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
    {%- if product.images.size > 1 -%}
      <button class="pdp-lightbox__nav pdp-lightbox__nav--prev" type="button" id="pdp-lightbox-prev" aria-label="{{ 'pdp.gallery.prev' | t }}">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <button class="pdp-lightbox__nav pdp-lightbox__nav--next" type="button" id="pdp-lightbox-next" aria-label="{{ 'pdp.gallery.next' | t }}">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
      </button>
    {%- endif -%}
    <div class="pdp-lightbox__stage">
      <img class="pdp-lightbox__img" id="pdp-lightbox-img" alt="" width="1600" height="1600">
    </div>
    <div class="pdp-lightbox__counter mono" id="pdp-lightbox-counter"></div>
  </div>
{%- endif -%}
