{%- comment -%}
  Renders the collection sidebar filter form.

  Parameters:
    - paginate: the paginate object (required, used for the items count)
    - category_menu_handle: optional link list handle for category navigation
{%- endcomment -%}

<form
  class="coll-sidebar"
  id="CollectionFilters"
  method="get"
  action="{{ collection.url }}"
  novalidate
>
  <div class="coll-sidebar__header">
    <div class="display" style="font-size:22px;line-height:1">{{ 'collection.filters.title' | t }}</div>
    <a href="{{ collection.url }}" class="coll-sidebar__clear mono">{{ 'collection.filters.clear_all' | t }}</a>
  </div>

  {%- comment -%} Category navigation {%- endcomment -%}
  {%- if category_menu_handle != blank -%}
    <div class="coll-filter-section">
      <button type="button" class="coll-filter-section__toggle" aria-expanded="true" data-section-toggle="cat">
        <span class="mono">{{ 'collection.filters.category' | t }}</span>
        <svg class="coll-filter-section__chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
      </button>
      <div class="coll-filter-section__body" data-section-body="cat">
        <ul class="coll-cat-list">
          {%- for link in linklists[category_menu_handle].links -%}
            {%- assign link_count = '' -%}
            {%- if link.type == 'collection_link' and link.object != blank -%}
              {%- assign link_count = link.object.all_products_count -%}
            {%- elsif link.type == 'catalog_link' -%}
              {%- assign link_count = collections.all.all_products_count -%}
            {%- endif -%}
            <li>
              <a href="{{ link.url }}" class="coll-cat-item{% if link.active %} coll-cat-item--active{% endif %}">
                <span>{{ link.title }}</span>
                {%- if link_count != '' -%}
                  <span class="mono">{{ link_count }}</span>
                {%- endif -%}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} Brand (vendor) {%- endcomment -%}
  {%- for filter in collection.filters -%}
    {%- if filter.type == 'list' and filter.param_name == 'filter.p.vendor' -%}
      {% render 'collection-filter-list', filter: filter %}
    {%- endif -%}
  {%- endfor -%}

  {%- comment -%} Fallback: vendor list when Shopify filters not configured {%- endcomment -%}
  {%- if collection.filters.size == 0 and collection.all_vendors.size > 0 -%}
    <div class="coll-filter-section">
      <button type="button" class="coll-filter-section__toggle" aria-expanded="true" data-section-toggle="vendor">
        <span class="mono">{{ 'collection.filters.brand' | t }}</span>
        <svg class="coll-filter-section__chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
      </button>
      <div class="coll-filter-section__body" data-section-body="vendor">
        <ul class="coll-check-list" data-check-list="vendor">
          {%- for vendor in collection.all_vendors -%}
            <li{% if forloop.index > 8 %} class="coll-check-overflow" hidden{% endif %}>
              <label class="coll-check-label">
                <input
                  class="coll-check-input"
                  type="checkbox"
                  name="filter.p.vendor"
                  value="{{ vendor }}"
                >
                <span class="coll-check-box" aria-hidden="true"></span>
                <span class="coll-check-label__text">{{ vendor }}</span>
              </label>
            </li>
          {%- endfor -%}
        </ul>
        {%- if collection.all_vendors.size > 8 -%}
          {%- assign vendor_overflow = collection.all_vendors.size | minus: 8 -%}
          <button type="button" class="coll-show-more mono" data-show-more="vendor">
            {{ 'collection.filters.show_more' | t: count: vendor_overflow }}
          </button>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

</form>
