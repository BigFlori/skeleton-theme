{%- if is_solar == nil -%}{%- assign is_solar = false -%}{%- endif -%}
<script>
window.PDP_I18N = {
  added:             {{ 'pdp.toast.added' | t | json }},
  errorPrefix:       {{ 'pdp.toast.error_prefix' | t | json }},
  {%- if is_solar %}
  qtyLabelOne:       {{ 'pdp.qty.label.one' | t | json }},
  qtyLabelOther:     {{ 'pdp.qty.label.other' | t | json }},
  {%- else %}
  qtyLabelOne:       {{ 'pdp.qty.label_generic.one' | t | json }},
  qtyLabelOther:     {{ 'pdp.qty.label_generic.other' | t | json }},
  {%- endif %}
  addToCart:         {{ 'pdp.buy.add_to_cart' | t | json }}
  {%- if is_solar %},
  compatPerfect:     {{ 'pdp.compat.perfect' | t | json }},
  compatSlightOver:  {{ 'pdp.compat.slight_over' | t | json }},
  compatUnderLoaded: {{ 'pdp.compat.under_loaded' | t | json }},
  compatUnderMpptMin: {{ 'pdp.compat.under_mppt_min' | t | json }},
  compatTooMany:     {{ 'pdp.compat.too_many' | t | json }},
  compatSummary:     {{ 'pdp.compat.summary' | t | json }},
  vocLabel:          {{ 'pdp.compat.voc_label' | t | json }}
  {%- endif %}
};
window.PDP_CONFIG = {
  basePriceCents:    {{ current_variant.price }},
  compareAtCents:    {% if current_variant.compare_at_price %}{{ current_variant.compare_at_price }}{% else %}null{% endif %},
  currencyCode:      {{ shop.currency | json }},
  {%- if is_solar %}
  {%- assign ds = product.metafields.custom.datasheet.value -%}
  {%- assign voc_val = ds.voc | default: 38.9 -%}
  {%- assign vmp_val = ds.vmp | default: 32.4 -%}
  {%- comment -%} Cold Voc at T_min = -10°C with fixed tc = -0.30 %/°C → factor 1.105 {%- endcomment -%}
  {%- assign cold_voc_val = voc_val | times: 1.105 -%}
  moduleKwp:      {{ ds.module_power_kwp | default: 0.425 }},
  voc:            {{ voc_val }},
  vmp:            {{ vmp_val }},
  coldVoc:        {{ cold_voc_val }},
  {%- else %}
  moduleKwp:      0,
  voc:            0,
  vmp:            0,
  coldVoc:        0,
  {%- endif %}
  productTitle:   {{ product.title | json }},
  variants:       {{ product.variants | json }},
  discountTiers:  [],
  priceBands:     []
};
</script>
<script src="{{ 'pdp.js' | asset_url }}" defer></script>
