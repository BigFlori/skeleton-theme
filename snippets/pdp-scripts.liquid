<script>
window.PDP_I18N = {
  added:             {{ 'pdp.toast.added' | t | json }},
  errorPrefix:       {{ 'pdp.toast.error_prefix' | t | json }},
  qtyLabelOne:       {{ 'pdp.qty.label.one' | t | json }},
  qtyLabelOther:     {{ 'pdp.qty.label.other' | t | json }},
  addToCart:         {{ 'pdp.buy.add_to_cart' | t | json }},
  {%- comment -%} Volume discount i18n — disabled until the discount app is built
  discountBadge:     {{ 'pdp.qty.discount_badge' | t | json }},
  tierHeading:       {{ 'pdp.qty.tier_heading' | t | json }},
  tierRowHtml:       {{ 'pdp.qty.tier_row_html' | t | json }},
  tierSourceTest:    {{ 'pdp.qty.tier_source_test' | t | json }},
  tierSourceProduct: {{ 'pdp.qty.tier_source_product' | t | json }},
  tierSourceBand:    {{ 'pdp.qty.tier_source_band' | t | json }},
  {%- endcomment -%}
  compatPerfect:     {{ 'pdp.compat.perfect' | t | json }},
  compatSlightOver:  {{ 'pdp.compat.slight_over' | t | json }},
  compatUnderLoaded: {{ 'pdp.compat.under_loaded' | t | json }},
  compatTooMany:     {{ 'pdp.compat.too_many' | t | json }},
  compatSummary:     {{ 'pdp.compat.summary' | t | json }},
  vocLabel:          'bei Voc'
};
{%- comment -%} Volume discount metafields — disabled until the discount app is built
{%- assign volume_tiers_raw = product.metafields.custom.volume_tiers.value -%}
{%- assign price_bands_raw = shop.metafields.custom.volume_tier_bands.value -%}
{%- endcomment -%}
window.PDP_CONFIG = {
  basePriceCents:    {{ current_variant.price }},
  compareAtCents:    {% if current_variant.compare_at_price %}{{ current_variant.compare_at_price }}{% else %}null{% endif %},
  currencyCode:      {{ shop.currency | json }},
  moduleKwp:      {{ product.metafields.custom.datasheet.value.module_power_kwp | default: 0.425 }},
  voc:            {{ product.metafields.custom.datasheet.value.voc | default: 38.9 }},
  productTitle:   {{ product.title | json }},
  variants:       {{ product.variants | json }},
  {%- comment -%} Volume discount config — disabled until the discount app is built
  discountTiers:  {% if volume_tiers_raw %}{{ volume_tiers_raw | json }}{% else %}[]{% endif %},
  priceBands:     {% if price_bands_raw %}{{ price_bands_raw | json }}{% else %}[]{% endif %}
  {%- endcomment -%}
  discountTiers:  [],
  priceBands:     []
};
</script>
<script src="{{ 'pdp.js' | asset_url }}" defer></script>
