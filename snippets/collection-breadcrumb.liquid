{%- comment -%}
  Renders the breadcrumb for the collection page.
  Uses the global `collection` object.
{%- endcomment -%}

<div class="container">
  <nav class="coll-breadcrumb mono" aria-label="{{ 'collection.breadcrumb.label' | t }}">
    <a href="{{ routes.root_url }}">{{ 'collection.breadcrumb.home' | t }}</a>
    <span aria-hidden="true">/</span>
    <a href="{{ routes.collections_url }}">{{ 'collection.breadcrumb.shop' | t }}</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{{ collection.title }}</span>
  </nav>
</div>
