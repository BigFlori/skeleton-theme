{%- comment -%}
  Renders the active filter chips row. Uses the global `collection` object.
{%- endcomment -%}

{%- liquid
  assign has_active = false
  for filter in collection.filters
    if filter.active_values.size > 0
      assign has_active = true
    endif
  endfor
-%}

{%- if has_active -%}
  <div class="coll-active-filters">
    <span class="mono coll-active-label">{{ 'collection.filters.active_label' | t }}</span>

    {%- for filter in collection.filters -%}
      {%- for value in filter.active_values -%}
        <span class="filter-chip">
          {{ value.label }}
          <a href="{{ value.url_to_remove }}" class="filter-chip__remove" aria-label="{{ 'collection.filters.remove_filter_aria' | t: label: value.label }}">×</a>
        </span>
      {%- endfor -%}
    {%- endfor -%}

    {%- if collection.handle == 'all' -%}
      <a href="{{ collections['all-products'].url }}" class="coll-clear-all mono">{{ 'collection.filters.clear_all' | t }}</a>
    {%- else -%}
      <a href="{{ collection.url }}" class="coll-clear-all mono">{{ 'collection.filters.clear_all' | t }}</a>
    {%- endif -%}
  </div>
{%- endif -%}
