<section class="sw-cart-empty">
  <div class="container sw-cart-empty__inner">
    <div class="sw-cart-empty__icon" aria-hidden="true">
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{%- render 'icon', icon: 'cart' -%}</svg>
    </div>
    <h1 class="display sw-cart-empty__title">{{ 'sections.cart.empty_title' | t }}</h1>
    <p class="sw-cart-empty__body">{{ 'sections.cart.empty_body' | t }}</p>
    <div class="sw-cart-empty__actions">
      <a href="{{ section.settings.packages_url | default: routes.root_url }}" class="btn btn-primary">
        {{ 'sections.cart.empty_packages' | t }}
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{%- render 'icon', icon: 'arrow-right' -%}</svg>
      </a>
      <a href="{{ routes.collections_url }}" class="btn btn-secondary">
        {{ 'sections.cart.empty_components' | t }}
      </a>
    </div>
  </div>
</section>
