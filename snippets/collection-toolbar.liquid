{%- comment -%}
  Renders the toolbar above the product grid (title, results count, sort).

  Parameters:
    - paginate: paginate object (required)
    - sort_by: currently selected sort key (required)
{%- endcomment -%}

<div class="coll-toolbar">
  <div>
    {%- if collection.handle == 'all-products' -%}
      <span class="eyebrow">{{ 'collection.toolbar.eyebrow' | t }}</span>
      <h2 class="display coll-toolbar__title">{{ 'collection.toolbar.title_pre' | t }} <em>{{ 'collection.toolbar.title_em' | t }}</em></h2>
    {%- else -%}
      <h2 class="display coll-toolbar__title"><em>{{ collection.title }}</em></h2>
    {%- endif -%}
  </div>
  <div class="coll-toolbar__right">
    <button
      type="button"
      class="coll-filters-trigger mono"
      data-filters-trigger
      aria-controls="CollectionFilters"
      aria-expanded="false"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        {%- render 'icon', icon: 'filter' -%}
      </svg>
      <span>{{ 'collection.filters.title' | t }}</span>
    </button>
    <span class="mono coll-toolbar__count">{{ 'collection.toolbar.results' | t: count: paginate.items }}</span>
    <div class="coll-toolbar__divider"></div>
    <label class="coll-sort-wrap">
      <span class="mono coll-sort-label">{{ 'collection.toolbar.sort_label' | t }}</span>
      <select
        class="coll-sort-select"
        name="sort_by"
        form="CollectionFilters"
        aria-label="{{ 'collection.toolbar.sort_aria' | t }}"
      >
        {%- for option in collection.sort_options -%}
          <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>
        {%- endfor -%}
      </select>
    </label>
  </div>
</div>
