<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% comment %}
      Font preloading:
      1. Preconnect to font CDN for faster connection
      2. Preload only the critical font variant (base weight)
      3. Additional variants load on-demand via @font-face
    {% endcomment %}
    {% unless settings.type_primary_font.system? %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
      {{ settings.type_primary_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}

    {%- comment -%}
      Sonnwerk: Crimson Pro + Geist + Geist Mono are self-hosted (see
      snippets/css-variables.liquid for the @font-face rules) and served from
      the Shopify CDN — no external Google Fonts request.
    {%- endcomment -%}
    {{ 'geist.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'sonnwerk.css' | asset_url | stylesheet_tag }}
    {{ 'pkg-card.css' | asset_url | stylesheet_tag }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}

    {% comment %}
      sw-utils.js must load before any section/template script that uses SwUtils
      (e.g. cart.js). Defer scripts run in document order, so placing this in
      <head> guarantees it executes before body-level defer scripts.
    {% endcomment %}
    <script src="{{ 'sw-utils.js' | asset_url }}" defer></script>
  </head>

  <body>
    <a class="sw-skip-link" href="#main-content">{{ 'general.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="main-content" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% section 'cart-drawer' %}

    <script src="{{ 'cart-drawer.js' | asset_url }}" defer></script>
    {%- comment -%}
      Global add-to-cart handler for [data-atc-id] product-card buttons.
      Loaded here (not per-section) so cards work on every page, incl. the PDP
      recently-viewed carousel. Depends on the cart-drawer section above for the
      toast element + swDrawerConfig strings.
    {%- endcomment -%}
    <script src="{{ 'cart-atc.js' | asset_url }}" defer></script>
  </body>
</html>
